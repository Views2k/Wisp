root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml}]
indent_style = space
indent_size = 2

[*.xaml]
indent_style = space
indent_size = 4

[*.{ps1,iss}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.py]
indent_style = space
indent_size = 4
end_of_line = lf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
