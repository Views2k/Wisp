<UserControl x:Class="Wisp.App.FeatureTourBanner"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18,14" BorderThickness="0">
  <StackPanel>
   <TextBlock Text="Welcome to Wisp 2.0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
   <TextBlock Text="Discover the drift gauge, second-screen dashboard and improved Runs workspace." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/>
   <WrapPanel>
    <Button x:Name="TourStartButton" Content="Take a quick tour" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="14,8" AutomationProperties.Name="Take a quick tour of Wisp"/>
    <Button x:Name="TourDismissButton" Content="Dismiss" Padding="14,8"/>
    <TextBlock Text="About a minute · optional" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="12,4,0,4"/>
   </WrapPanel>
   <WrapPanel x:Name="TourSaveFeedback" Visibility="Collapsed" Margin="0,9,0,0">
    <TextBlock Text="Couldn't remember your choice." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,0,8,0"/>
    <Button x:Name="TourRetryButton" Content="Retry saving" Padding="10,6"/>
   </WrapPanel>
  </StackPanel>
 </Border>
</UserControl>
