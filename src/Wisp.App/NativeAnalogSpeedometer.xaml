<UserControl x:Class="Wisp.App.NativeAnalogSpeedometer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wisp.App"
             Width="293" Height="293.5"
             IsHitTestVisible="False"
             ClipToBounds="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Width="293" Height="293.5" ClipToBounds="False">
        <!-- The authored 288x288 coordinate system deliberately overdraws its
             right/bottom edge.  Give the procedural material the same five-pixel
             overflow already reserved by OverlayWindow instead of clipping the
             9/10 redline at the child control boundary. -->
        <local:NativeAnalogMaterialVisual x:Name="MaterialVisual" Width="288" Height="288"
                                          HorizontalAlignment="Left" VerticalAlignment="Top" />
        <local:NativeAnalogGaugeVisual x:Name="GaugeVisual" Width="293" Height="293.5"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       ClipToBounds="False" />

        <Grid x:Name="NativeCoordinateGrid" Width="288" Height="288"
              Margin="0,0,5,-5.5" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid x:Name="OverlayGrid" Margin="0,0,0,3">
            <!-- FH6 rotates the assist *container*, not the icon itself.  The 132px
                 bottom margin places the icon away from the rotation pivot, so changing
                 ABS/TCR/LC/STM angle orbits the icon around the gauge center. -->
            <Grid x:Name="AssistGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Decorator RenderTransformOrigin="0.5,0.5">
                    <Decorator.RenderTransform><RotateTransform x:Name="AbsRotation" /></Decorator.RenderTransform>
                    <Image x:Name="AbsImage" Width="54" Height="33" Margin="0,0,0,132" Stretch="Fill" />
                </Decorator>
                <Decorator RenderTransformOrigin="0.5,0.5">
                    <Decorator.RenderTransform><RotateTransform x:Name="TcrRotation" /></Decorator.RenderTransform>
                    <Image x:Name="TcrImage" Width="54" Height="33" Margin="0,0,0,132" Stretch="Fill" />
                </Decorator>
                <Decorator RenderTransformOrigin="0.5,0.5">
                    <Decorator.RenderTransform><RotateTransform x:Name="LcRotation" /></Decorator.RenderTransform>
                    <Image x:Name="LcImage" Width="54" Height="33" Margin="0,0,0,132" Stretch="Fill" />
                </Decorator>
                <Decorator RenderTransformOrigin="0.5,0.5">
                    <Decorator.RenderTransform><RotateTransform x:Name="StmRotation" /></Decorator.RenderTransform>
                    <Image x:Name="StmImage" Width="54" Height="33" Margin="0,0,0,132" Stretch="Fill" />
                </Decorator>
            </Grid>

            <Image x:Name="GearImage" Width="100" Height="100"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Stretch="Fill" />

            <!-- FH6's custom renderer permits its needle material to overflow a
                 zero-sized anchor. WPF culls ShaderEffect content beneath that
                 anchor, so retain the native 288x288 pivot and material bounds
                 on a nonzero host. -->
            <Canvas x:Name="Needle" Width="288" Height="288"
                    ClipToBounds="False"
                    RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="NeedleRotation" />
                </Canvas.RenderTransform>
                <local:NativeAnalogNeedleVisual x:Name="NeedleMaterial"
                                                Canvas.Left="178.5"
                                                Canvas.Top="54"
                                                Width="110" Height="180" />
            </Canvas>

            <Image x:Name="UnitImage" Height="23"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Margin="0,0,2,104" Stretch="Fill" Opacity="0.50" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                        HorizontalAlignment="Right" Margin="0,0,12,1">
                <Grid Width="60" Height="93" Margin="-4,0,0,0">
                    <Image x:Name="HundredsImage" Width="60" Height="93" Stretch="Fill" />
                </Grid>
                <Grid Width="60" Height="93" Margin="-4,0,0,0">
                    <Image x:Name="TensImage" Width="60" Height="93" Stretch="Fill" />
                </Grid>
                <Grid Width="60" Height="93" Margin="-4,0,0,0">
                    <Image x:Name="OnesImage" Width="60" Height="93" Stretch="Fill" />
                </Grid>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
