<UserControl x:Class="Wisp.App.NativeElectricDigitalSpeedometer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="160"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Width="320" Height="160" Margin="0,0,0,-15">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Width="302" Margin="0,0,-7.5,0">
            <Image x:Name="GearGaugeImage" Width="34" Height="98"
                   Margin="0,0,-15,-5" Stretch="Fill" Visibility="Collapsed" />
            <Grid Width="68" Height="68" VerticalAlignment="Bottom"
                  Margin="0.5,0,7.5,30">
                <Image x:Name="NextGearImage" Width="25" Height="30"
                       Opacity="0.40" Visibility="Collapsed">
                    <Image.RenderTransform><TranslateTransform X="8" Y="-48" /></Image.RenderTransform>
                </Image>
                <Image x:Name="GearImage" Width="68" Height="68" Stretch="Fill" />
            </Grid>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                        Margin="0,0,0,26">
                <Grid Width="70" Height="106" Margin="-10,0,0,0">
                    <Image x:Name="HundredsImage" Width="70" Height="106" Stretch="Fill" />
                </Grid>
                <Grid Width="70" Height="106" Margin="-10,0,0,0">
                    <Image x:Name="TensImage" Width="70" Height="106" Stretch="Fill" />
                </Grid>
                <Grid Width="70" Height="106" Margin="-10,0,0,0">
                    <Image x:Name="OnesImage" Width="70" Height="106" Stretch="Fill" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom"
                        HorizontalAlignment="Right" Margin="-17,0,0,27"
                        RenderTransformOrigin="0.5,1">
                <StackPanel.RenderTransform><SkewTransform AngleX="-11" /></StackPanel.RenderTransform>
                <Decorator RenderTransformOrigin="0.5,1">
                    <Decorator.RenderTransform><SkewTransform AngleX="11" /></Decorator.RenderTransform>
                    <Image x:Name="UnitImage" Width="44" Height="23"
                           Margin="0,0,0,-1" Stretch="Fill" Opacity="0.30" />
                </Decorator>
                <StackPanel x:Name="AssistStack" Margin="0,4,0,0">
                    <Decorator Margin="0,-6" RenderTransformOrigin="0.5,1">
                        <Decorator.RenderTransform><SkewTransform AngleX="11" /></Decorator.RenderTransform>
                        <Image x:Name="StmImage" Width="54" Height="32" Stretch="Fill" />
                    </Decorator>
                    <Decorator Margin="0,-6" RenderTransformOrigin="0.5,1">
                        <Decorator.RenderTransform><SkewTransform AngleX="11" /></Decorator.RenderTransform>
                        <Image x:Name="AbsImage" Width="54" Height="32" Stretch="Fill" />
                    </Decorator>
                    <Decorator Margin="0,-6" RenderTransformOrigin="0.5,1">
                        <Decorator.RenderTransform><SkewTransform AngleX="11" /></Decorator.RenderTransform>
                        <Image x:Name="LcImage" Width="54" Height="32" Stretch="Fill" />
                    </Decorator>
                    <Decorator Margin="0,-6" RenderTransformOrigin="0.5,1">
                        <Decorator.RenderTransform><SkewTransform AngleX="11" /></Decorator.RenderTransform>
                        <Image x:Name="TcrImage" Width="54" Height="32" Stretch="Fill" />
                    </Decorator>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="PowerBarPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="24,0,6,7">
            <Image x:Name="RegenLabelImage" Width="33.5" Height="21"
                   Margin="0,0,6,-4" VerticalAlignment="Center" Opacity="0.67" />
            <Grid x:Name="PowerBarGrid" Width="215" Height="16" VerticalAlignment="Center">
                <Grid.RenderTransform><SkewTransform AngleX="-8" /></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RegenColumn" Width="64.5" />
                    <ColumnDefinition x:Name="PowerColumn" Width="150.5" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Background="#4DFFFFFF" ClipToBounds="True">
                    <Rectangle x:Name="RegenIndicator" Fill="White" HorizontalAlignment="Right" Width="0" />
                </Grid>
                <Grid Grid.Column="1" Background="#4DFFFFFF" ClipToBounds="True">
                    <Rectangle x:Name="PowerIndicator" Fill="#FF429BA5" HorizontalAlignment="Left" Width="0" />
                </Grid>
            </Grid>
            <Image x:Name="PowerLabelImage" Width="33.5" Height="21"
                   Margin="6,0,0,-4" VerticalAlignment="Center" Opacity="0.67" />
        </StackPanel>
    </Grid>
</UserControl>
