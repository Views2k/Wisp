<UserControl x:Class="Wisp.App.StandaloneGaugePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wisp.App"
             IsHitTestVisible="False">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding BoostGaugeEnabled}" Value="False" />
                        <Condition Binding="{Binding TireTemperatureGaugeEnabled}" Value="False" />
                        <Condition Binding="{Binding PowerGaugeEnabled}" Value="False" />
                        <Condition Binding="{Binding TorqueGaugeEnabled}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding NativePreviewFrame.IsElectric}" Value="True" />
                        <Condition Binding="{Binding TireTemperatureGaugeEnabled}" Value="False" />
                        <Condition Binding="{Binding PowerGaugeEnabled}" Value="False" />
                        <Condition Binding="{Binding TorqueGaugeEnabled}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <StackPanel Orientation="Horizontal">
        <StackPanel VerticalAlignment="Center">
            <local:AnalogBoostGaugeView Width="136" Height="136" Margin="4"
                                       Display="{Binding PreviewBoostDisplay}"
                                       PressureUnit="{Binding SelectedBoostPressureUnit}"
                                       ColorNumber="{Binding BoostGaugeColorNumber}"
                                       LowBrush="{DynamicResource BoostLowBrush}"
                                       MidBrush="{DynamicResource BoostMidBrush}"
                                       HighBrush="{DynamicResource BoostHighBrush}">
                <local:AnalogBoostGaugeView.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding BoostGaugeScale}" ScaleY="{Binding BoostGaugeScale}" />
                </local:AnalogBoostGaugeView.LayoutTransform>
                <local:AnalogBoostGaugeView.Style>
                    <Style TargetType="local:AnalogBoostGaugeView">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BoostGaugeEnabled}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding NativePreviewFrame.IsElectric}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AnalogBoostGaugeView.Style>
            </local:AnalogBoostGaugeView>
            <Grid Margin="4">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding TireTemperatureGaugeScale}" ScaleY="{Binding TireTemperatureGaugeScale}" />
                </Grid.LayoutTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TireTemperatureGaugeEnabled}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <local:AnalogTireTemperatureGaugeView Width="136" Height="136"
                    Display="{Binding PreviewTireTemperatureDisplay}"
                    TemperatureUnit="{Binding SelectedTireTemperatureUnit}"
                    ReactiveColors="{Binding TireTemperatureReactiveColors}"
                    IsElectricMaterial="{Binding NativePreviewFrame.IsElectric}"
                    LowBrush="{DynamicResource BoostLowBrush}" MidBrush="{DynamicResource BoostMidBrush}" HighBrush="{DynamicResource BoostHighBrush}">
                    <local:AnalogTireTemperatureGaugeView.Style>
                        <Style TargetType="local:AnalogTireTemperatureGaugeView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NativeGaugeSelectionIndex}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:AnalogTireTemperatureGaugeView.Style>
                </local:AnalogTireTemperatureGaugeView>
                <local:DigitalTireTemperatureGaugeView Width="302" Height="84"
                    Display="{Binding PreviewTireTemperatureDisplay}"
                    TemperatureUnit="{Binding SelectedTireTemperatureUnit}"
                    ReactiveColors="{Binding TireTemperatureReactiveColors}"
                    LowBrush="{DynamicResource BoostLowBrush}" MidBrush="{DynamicResource BoostMidBrush}" HighBrush="{DynamicResource BoostHighBrush}">
                    <local:DigitalTireTemperatureGaugeView.Style>
                        <Style TargetType="local:DigitalTireTemperatureGaugeView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NativeGaugeSelectionIndex}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:DigitalTireTemperatureGaugeView.Style>
                </local:DigitalTireTemperatureGaugeView>
            </Grid>
        </StackPanel>
        <local:PowerTorqueGaugePairPreview VerticalAlignment="Center" Margin="4" />
    </StackPanel>
</UserControl>
