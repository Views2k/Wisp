<UserControl x:Class="Wisp.App.Runs.LapReviewView" x:Name="ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:focus="clr-namespace:Wisp.App"
    xmlns:local="clr-namespace:Wisp.App.Runs">
    <UserControl.Resources>
        <local:LapReviewMapHeightConverter x:Key="LapReviewMapHeight" />
        <local:LapReviewCompactViewportConverter x:Key="CompactMapViewport" />
        <BooleanToVisibilityConverter x:Key="MapVisibility" />
        <Style x:Key="LapMapMode" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeSurface" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="{DynamicResource RaisedBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeSurface" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="focus:FocusCues.ShowKeyboardFocus" Value="True" /></MultiTrigger.Conditions>
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LapCursorLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="LapCursorValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <DataTemplate x:Key="LapWheelReadout" DataType="{x:Type local:LapReviewWheelReadout}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding FrontLeft}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{Binding FrontRight}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Text="{Binding RearLeft}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Grid.Column="4" Text="{Binding RearRight}" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel>
            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Background="{DynamicResource InputBrush}" Margin="0,4,0,14">
            <StackPanel>
            <WrapPanel x:Name="MapToolbar" IsEnabled="{Binding HasLap}" Margin="16,10,16,4">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="3" Margin="0,0,14,6">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="View2D" Content="2D" Style="{StaticResource LapMapMode}" GroupName="LapMapMode" IsChecked="{Binding Is2D}" AutomationProperties.Name="2D lap map" />
                        <RadioButton x:Name="View3D" Content="3D" Style="{StaticResource LapMapMode}" GroupName="LapMapMode" IsChecked="{Binding Is3D}" Margin="3,0,0,0" AutomationProperties.Name="3D lap map" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                    <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="155" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" DisplayMemberPath="Label" AutomationProperties.Name="Lap map and graph channel" />
                </StackPanel>
                <ComboBox Width="130" ItemsSource="{Binding Wheels}" SelectedIndex="{Binding SelectedWheel}" IsEnabled="{Binding IsWheelChannel}" Visibility="{Binding IsWheelChannel, Converter={StaticResource MapVisibility}}" Margin="0,0,12,6" VerticalAlignment="Center" AutomationProperties.Name="Wheel for tire or suspension channel" />
                <Button x:Name="SaveMapPng" Content="Save PNG" Click="SaveMapPng_Click" Padding="14,8" Margin="0,0,8,6" VerticalAlignment="Center" AutomationProperties.Name="Save the current lap map as PNG">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Is3D}" Value="True" />
                                        <Condition Binding="{Binding IsPreparing, ElementName=Track3D}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="False" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <CheckBox x:Name="SharedSpaceToggle" Content="Shared space" IsChecked="{Binding SharedSpace}" IsEnabled="{Binding CanUseSharedSpace}" Visibility="{Binding Is3D, Converter={StaticResource MapVisibility}}" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Margin="0,0,8,6" AutomationProperties.Name="Compare laps in a shared 3D space" />
                <CheckBox x:Name="ShowContactsToggle" Content="Show contacts" IsChecked="{Binding ShowContacts}" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Margin="0,0,12,6" />
                <WrapPanel x:Name="CameraControls" Visibility="{Binding Is3D, Converter={StaticResource MapVisibility}}">
                    <Button x:Name="ZoomMapIn" Content="Zoom in" Click="ZoomMapIn_Click" Padding="10,8" Margin="0,0,8,6" />
                    <Button x:Name="ZoomMapOut" Content="Zoom out" Click="ZoomMapOut_Click" Padding="10,8" Margin="0,0,8,6" />
                    <Button x:Name="ResetCamera" Content="Reset camera" Click="ResetMapView_Click" Padding="10,8" Margin="0,0,8,6" AutomationProperties.Name="Reset the 3D workspace camera" />
                </WrapPanel>
                <Button x:Name="ShowBothMaps" Content="Show both laps" Click="ShowBothMaps_Click" Padding="10,8" Margin="0,0,8,6" VerticalAlignment="Center" Visibility="{Binding IsMapComparison, Converter={StaticResource MapVisibility}}" />
            </WrapPanel>
            <Grid x:Name="ScrubBar" IsEnabled="{Binding HasLap}" Margin="16,0,16,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Lap position" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border x:Name="ScrubTargetSelector" ToolTip="{Binding ScrubHint}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="2" Margin="0,0,12,2" Visibility="{Binding IsMapComparison, Converter={StaticResource MapVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ScrubBoth" Content="Both" Style="{StaticResource LapMapMode}" Padding="10,4" GroupName="LapScrubTarget" IsChecked="{Binding ScrubBoth}" AutomationProperties.Name="Scrub both laps" />
                            <RadioButton x:Name="ScrubA" Content="A" Style="{StaticResource LapMapMode}" Padding="10,4" GroupName="LapScrubTarget" IsChecked="{Binding ScrubA}" AutomationProperties.Name="Scrub Run A only" />
                            <RadioButton x:Name="ScrubB" Content="B" Style="{StaticResource LapMapMode}" Padding="10,4" GroupName="LapScrubTarget" IsChecked="{Binding ScrubB}" AutomationProperties.Name="Scrub Run B only" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ScrubPosition}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </WrapPanel>
                <Slider x:Name="LapCursorSlider" Grid.Row="1" Minimum="0" Maximum="{Binding MaximumScrubCursor}" Value="{Binding ScrubCursor, Mode=TwoWay, UpdateSourceTrigger=Explicit}" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="60" AutomationProperties.Name="Lap position cursor" ValueChanged="LapCursorSlider_ValueChanged" />
            </Grid>
            <Grid x:Name="MapExportSurface" IsEnabled="{Binding HasLap}" Background="{DynamicResource InputBrush}" Margin="1,0,1,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid x:Name="MapReadout" Margin="16,10,16,6">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Row" Value="0"/><Style.Triggers>
                            <DataTrigger Binding="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource CompactMapViewport}}" Value="True"><Setter Property="Grid.Row" Value="1"/></DataTrigger>
                        </Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsMapComparison}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1" /></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding MapATitle}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding MapATitle}" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding MapCursorValue}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Visibility="{Binding IsMapComparison, Converter={StaticResource MapVisibility}}">
                            <TextBlock Text="{Binding MapBTitle}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding MapBTitle}" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding MapBCursorValue}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ScrubHint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding IsMapComparison, Converter={StaticResource MapVisibility}}" />
                    </Grid>
                    <Grid x:Name="MapViewport">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Row" Value="1"/><Style.Triggers>
                            <DataTrigger Binding="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource CompactMapViewport}}" Value="True"><Setter Property="Grid.Row" Value="0"/></DataTrigger>
                        </Style.Triggers></Style></Grid.Style>
                        <Grid.Height><MultiBinding Converter="{StaticResource LapReviewMapHeight}"><Binding Path="ViewportHeight" RelativeSource="{RelativeSource AncestorType={x:Type ScrollViewer}}"/><Binding Path="RequestedMapHeight" ElementName="ReviewView"/><Binding Path="ActualHeight" ElementName="MapToolbar"/><Binding Path="ActualHeight" ElementName="ScrubBar"/><Binding Path="ActualHeight" ElementName="MapReadout"/><Binding Path="ViewportHeight" RelativeSource="{RelativeSource AncestorType={x:Type ScrollViewer}}" Converter="{StaticResource CompactMapViewport}"/></MultiBinding></Grid.Height>
                        <local:LapReviewPlot x:Name="Track" Data="{Binding MapPlotA}" IsMap="True" Visibility="{Binding Is2D, Converter={StaticResource MapVisibility}}" AutomationProperties.Name="Recorded lap map. Click to select a location; arrow keys move through samples." />
                        <local:LapReviewTrack3D x:Name="Track3D" Data="{Binding MapPlotA}" ComparisonData="{Binding ComparisonMapPlot}" Visibility="{Binding Is3D, Converter={StaticResource MapVisibility}}" AutomationProperties.Name="3D lap workspace. Click a track to move closer, drag to rotate, scroll out to see both. Arrow keys select points." />
                    </Grid>
                <StackPanel Grid.Row="2" Margin="16,8,16,16">
                    <Border Background="{DynamicResource StrokeBrush}" Height="1" Margin="0,0,0,14" Opacity="0.65" />
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LegendTitle}" FontWeight="SemiBold" Margin="0,0,12,8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LegendMinimum}" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <Rectangle Width="160" Height="8" RadiusX="4" RadiusY="4" Fill="{x:Static local:LapReviewPalette.LegendBrush}" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LegendMaximum}" Margin="0,0,18,8" VerticalAlignment="Center" />
                        <TextBlock Text="○ Start" Foreground="{x:Static local:LapReviewPalette.StartBrush}" Margin="0,0,14,8" />
                        <TextBlock Text="━ Reference" Foreground="{x:Static local:RunComparisonColors.RunB}" Margin="0,0,14,8" Visibility="{Binding HasMapReference, Converter={StaticResource MapVisibility}}" />
                        <TextBlock Text="✦ Contact marker" Foreground="{x:Static local:LapReviewPalette.ContactBrush}" Margin="0,0,12,8" Visibility="{Binding ShowContacts, Converter={StaticResource MapVisibility}}" />
                    </WrapPanel>
                    <TextBlock x:Name="MapElevationSummary" Text="{Binding ElevationSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Expander x:Name="LapSettings" Header="Lap settings and benchmark" Margin="16,0,16,12"><StackPanel Margin="12,10,12,0">
        <CheckBox Content="Save completed laps automatically" IsChecked="{Binding AutomaticRecording}" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,0,0,8" />
        <TextBlock Text="Uses the lap timing mode chosen in HUD settings. Saves locally while Wisp is running; older run recordings can also be reviewed here." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
        <TextBlock Text="{Binding CaptureStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />
        <WrapPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Review timing" FontSize="11" Margin="0,0,0,4" /><ComboBox Width="180" ItemsSource="{Binding TimingChoices}" SelectedItem="{Binding Timing}" DisplayMemberPath="Label" AutomationProperties.Name="Lap review timing mode" /></StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Your lap" FontSize="11" Margin="0,0,0,4" />
                <Grid>
                    <ComboBox x:Name="LapSelector" MinWidth="205" ItemsSource="{Binding Laps}" SelectedItem="{Binding Lap}" DisplayMemberPath="Label" IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Lap to review" />
                    <TextBlock x:Name="EmptyLapHint" Text="No recorded laps" Foreground="{DynamicResource MutedBrush}" Margin="10,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=LapSelector}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Reference lap" FontSize="11" Margin="0,0,0,4" />
                <Grid>
                    <ComboBox x:Name="ReferenceSelector" MinWidth="205" ItemsSource="{Binding ReferenceLaps}" SelectedItem="{Binding Reference}" DisplayMemberPath="Label" IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Reference lap" />
                    <TextBlock x:Name="EmptyReferenceHint" Text="No reference laps" Foreground="{DynamicResource MutedBrush}" Margin="10,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=ReferenceSelector}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />
        <WrapPanel Margin="0,0,0,8">
            <Button Content="Pin this lap as benchmark" Command="{Binding PinCommand}" IsEnabled="{Binding CanPin}" Padding="10,6" Margin="0,0,8,4" />
            <Button Content="Unpin benchmark" Command="{Binding UnpinCommand}" Padding="10,6" Margin="0,0,8,4" />
            <TextBlock Text="{Binding ReferenceStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
        </WrapPanel>
            </StackPanel></Expander>
            <Thumb x:Name="MapResizeGrip" IsEnabled="{Binding HasLap}" Height="20" Margin="16,0" Cursor="SizeNS" Focusable="True" IsTabStop="True"
                DragDelta="MapResizeGrip_DragDelta" KeyDown="MapResizeGrip_KeyDown"
                AutomationProperties.Name="Resize track area" AutomationProperties.HelpText="Drag to resize. Up and Down adjust height; Home restores automatic size."
                ToolTip="Drag to resize track area · Up/Down to adjust · Home to reset">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                    <Border x:Name="ResizeBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="32" Height="3" CornerRadius="1.5" Background="{DynamicResource StrokeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Resize map" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResizeBorder" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="focus:FocusCues.ShowKeyboardFocus" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ResizeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
            </Thumb>
            <StackPanel IsEnabled="{Binding HasLap}" Margin="16,0,16,8" Visibility="{Binding Is3D, Converter={StaticResource MapVisibility}}">
                <TextBlock Text="{Binding MapComparisonHint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="Drag to rotate · Shift/right drag to pan · Ctrl drag to roll · Click the map to use scroll zoom · Double-click to reset" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel x:Name="CameraAxes" Margin="0,0,0,0">
                        <TextBlock Text="Camera angles" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,8"/>
                        <StackPanel Width="130" Margin="0,0,14,8"><TextBlock Text="Yaw" FontSize="11" /><Slider Minimum="-180" Maximum="180" Value="{Binding Yaw, ElementName=Track3D, Mode=TwoWay}" AutomationProperties.Name="3D camera yaw" /></StackPanel>
                        <StackPanel Width="130" Margin="0,0,14,8"><TextBlock Text="Pitch" FontSize="11" /><Slider Minimum="-89" Maximum="89" Value="{Binding Pitch, ElementName=Track3D, Mode=TwoWay}" AutomationProperties.Name="3D camera pitch" /></StackPanel>
                        <StackPanel Width="130" Margin="0,0,14,8"><TextBlock Text="Roll" FontSize="11" /><Slider Minimum="-180" Maximum="180" Value="{Binding Roll, ElementName=Track3D, Mode=TwoWay}" AutomationProperties.Name="3D camera roll" /></StackPanel>
                    </WrapPanel>
            </StackPanel>
            <Expander Header="Contacts · Run A" IsEnabled="{Binding HasLap}" Margin="16,0,16,12">
            <StackPanel Margin="0,10,0,0">
            <TextBlock Text="{Binding ContactSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,6">
                <ComboBox Width="290" ItemsSource="{Binding ContactChoices}" SelectedItem="{Binding SelectedContact}" IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}" DisplayMemberPath="Label" AutomationProperties.Name="Lap contact markers" Margin="0,0,8,6" />
                <Button Content="Mark contact here" Command="{Binding MarkContactCommand}" Padding="10,6" Margin="0,0,8,6" />
                <Button Content="Remove marked contact" Command="{Binding RemoveContactCommand}" Padding="10,6" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock Text="Object contacts come from Forza's breakable-object telemetry in new recordings. Possible contacts are estimates, including on older laps. Mark known contacts to keep them with the run." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
            </Expander>
            <TextBlock Text="{Binding MapStatus}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" Margin="16,0,16,8" />
            </StackPanel>
            </Border>

            <local:LapReviewPlot x:Name="Trace" Data="{Binding Plot}" Height="190" Margin="0,0,0,8" AutomationProperties.Name="Lap channel by distance. Click or use arrow keys to move the shared cursor." />
            <Border x:Name="CursorReadout" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="At the cursor" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding CursorDetails.Position}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <WrapPanel DataContext="{Binding CursorDetails}">
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Speed" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding Speed}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Gear / RPM" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding Powertrain}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Throttle input" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding Throttle}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Brake input" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding Brake}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Steering input" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding Steering}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Lateral G" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding LateralG}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Longitudinal G" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding LongitudinalG}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Delta · lap − reference" Style="{StaticResource LapCursorLabel}" /><TextBlock Text="{Binding Delta}" Style="{StaticResource LapCursorValue}" /></StackPanel>
                    </WrapPanel>
                    <Expander x:Name="WheelReadings" Header="Tire and suspension readings">
                        <StackPanel Margin="0,8,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="FL" Style="{StaticResource LapCursorLabel}" /><TextBlock Grid.Column="2" Text="FR" Style="{StaticResource LapCursorLabel}" /><TextBlock Grid.Column="3" Text="RL" Style="{StaticResource LapCursorLabel}" /><TextBlock Grid.Column="4" Text="RR" Style="{StaticResource LapCursorLabel}" />
                            </Grid>
                            <ContentControl Content="{Binding CursorDetails.Temperatures}" ContentTemplate="{StaticResource LapWheelReadout}" />
                            <ContentControl Content="{Binding CursorDetails.SlipRatio}" ContentTemplate="{StaticResource LapWheelReadout}" />
                            <ContentControl Content="{Binding CursorDetails.SlipAngle}" ContentTemplate="{StaticResource LapWheelReadout}" />
                            <ContentControl Content="{Binding CursorDetails.Suspension}" ContentTemplate="{StaticResource LapWheelReadout}" />
                            <TextBlock Text="Suspension is normalized travel. Slip angle is the raw game value." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Start section here" Command="{Binding SectionStartCommand}" Padding="10,6" Margin="0,0,8,4" />
                <Button Content="End section here" Command="{Binding SectionEndCommand}" Padding="10,6" Margin="0,0,8,4" />
                <Button Content="Whole lap" Command="{Binding WholeLapCommand}" Padding="10,6" Margin="0,0,8,4" />
                <Button Content="Open section in graphs" Command="{Binding ShowGraphsCommand}" Padding="10,6" Margin="0,0,8,4" />
            </WrapPanel>
            <TextBlock Text="{Binding SectionText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><TextBlock Text="Selected section" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Your lap" Foreground="{x:Static local:RunComparisonColors.RunA}" /><TextBlock Grid.Column="2" Text="Reference · same positions" Foreground="{x:Static local:RunComparisonColors.RunB}" TextWrapping="Wrap" /></Grid>
            <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:LapReviewMetric}"><Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" /><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Margin="0,0,12,0" /><TextBlock Grid.Column="2" Text="{Binding Reference}" TextWrapping="Wrap" Foreground="{x:Static local:RunComparisonColors.RunB}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Expander Header="Braking, throttle pickup and shifts" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding Events}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,3" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
        </StackPanel>
    </StackPanel>
</UserControl>
