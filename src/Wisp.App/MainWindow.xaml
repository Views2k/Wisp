<local:ControlPanelWindow x:Class="Wisp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Wisp.App"
        xmlns:runs="clr-namespace:Wisp.App.Runs"
        Title="Wisp" Width="1440" Height="1000" MinWidth="720" MinHeight="440"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBrush}" WindowStartupLocation="CenterScreen" Cursor="Arrow"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="55" ResizeBorderThickness="6"
                            CornerRadius="8" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OrbitWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DashLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
            <Style x:Key="DashHeroLabel" TargetType="TextBlock" BasedOn="{StaticResource DashLabel}"><Setter Property="FontSize" Value="18"/></Style>
            <Style x:Key="DashAssist" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,8,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
            <Style x:Key="DashConnectionDot" TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource FaintBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasLiveTelemetry}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
            <local:ResponsivePageWidthConverter x:Key="ResponsivePageWidthConverter" />
            <local:GForceGaugeLayoutConverter x:Key="GForceGaugeLayoutConverter" />
            <BooleanToVisibilityConverter x:Key="ParticleVisibility" />
            <local:MetricPartConverter x:Key="MetricPartConverter" /><local:DashboardLiveValueConverter x:Key="DashboardLiveValueConverter"/>
            <SolidColorBrush x:Key="HudBorderBrush" Color="#6663D8D4" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
            CornerRadius="18">
        <Grid x:Name="ShellRoot">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ShellTitleRow" Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ShellFooterRow" Height="34" />
            </Grid.RowDefinitions>

            <local:AmbientBackdrop x:Name="AppParticles" Grid.RowSpan="3" Margin="18"
                                   ParticlesOnly="True" IsPointerInteractionEnabled="False"
                                   ParticleColor="{DynamicResource AppParticleColor}"
                                   Visibility="{Binding BackgroundParticlesEnabled, Converter={StaticResource ParticleVisibility}}"
                                   IsAnimationEnabled="{Binding AnimatedBackground}" />
            <local:DashboardRimEffect x:Name="DashboardRim" Grid.RowSpan="3"
                TargetElement="{Binding ElementName=OrbitInstrument}"
                Shape="{Binding Shape, ElementName=OrbitInstrument}"
                CornerRadius="{Binding CornerRadius, ElementName=OrbitInstrument}"
                RimThickness="{Binding BorderThickness, ElementName=OrbitInstrument}"
                Accent="{DynamicResource AccentBrush}" GlowOpacity="{DynamicResource OrbitGlowOpacity}"
                ParticlesEnabled="{Binding BackgroundParticlesEnabled}" IsAnimationEnabled="{Binding AnimatedBackground}">
                <local:DashboardRimEffect.Style>
                    <Style TargetType="local:DashboardRimEffect">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=RootTabs}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </local:DashboardRimEffect.Style>
            </local:DashboardRimEffect>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="WindowControls" Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,12,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowButtonStyle}"
                            Background="#FF5F57" Click="Close_Click"
                            AutomationProperties.Name="Close Wisp" ToolTip="Close window">
                        <Path Width="6" Height="6" Data="M0,0 L6,6 M6,0 L0,6"
                              Stroke="#C21E0C0D" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowButtonStyle}"
                            Background="#FEBC2E" Click="Minimize_Click"
                            AutomationProperties.Name="Minimize Wisp" ToolTip="Minimize">
                        <Path Width="6" Height="6" Data="M0,3 L6,3"
                              Stroke="#C21E0C0D" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowButtonStyle}"
                            Background="#28C840" Click="Maximize_Click"
                            AutomationProperties.Name="Maximize or restore Wisp" ToolTip="Maximize or restore">
                        <Rectangle Width="6" Height="6" Stroke="#B80C3419" StrokeThickness="1"
                                   RadiusX="1" RadiusY="1" />
                    </Button>
                </StackPanel>
                <StackPanel
                    x:Name="HeaderBrand"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0">
                    <Rectangle
                        x:Name="HeaderLogo"
                        Width="36"
                        Height="36"
                        Fill="{DynamicResource AccentBrush}"
                        AutomationProperties.Name="Wisp logo"
                        RenderOptions.BitmapScalingMode="HighQuality">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static local:WispLogoGlyph.Mask}" Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock x:Name="HeaderTitle" Text="Wisp" FontSize="24" FontWeight="SemiBold"
                               Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="DashboardWindowDisplayButton" Grid.Column="1" Content="Display mode  ↗" Click="DashboardDisplay_Click" VerticalAlignment="Center" Padding="16,8" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Dashboard for a second monitor (F11)" AutomationProperties.Name="Enter dashboard display mode"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=RootTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <Border
                    x:Name="HeaderStatus"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="24"
                    Margin="16,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="9,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=RootTabs}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Style="{StaticResource ConnectionStatusButtonStyle}" Click="ConnectionStatus_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Connection status" AutomationProperties.Name="Show connection status"><StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource FaintBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLiveTelemetry}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel></Button>
                </Border>
            </Grid>

            <Grid x:Name="ControlBody" Grid.Row="1" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="NavigationDockRow" Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="ContentPane" Grid.Row="0" Margin="16,0,16,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ContentTranslation" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PageTitleText" Text="{Binding SelectedItem.Header, ElementName=RootTabs}"
                               FontSize="23" FontWeight="SemiBold" Margin="4,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=RootTabs}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TabControl x:Name="RootTabs" Grid.Row="1" Style="{StaticResource SidebarPagesStyle}">
                        <TabItem x:Name="DashboardTab" Header="Dashboard">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid x:Name="DashboardToolbar" Visibility="Collapsed" Margin="12,10,12,14" Background="Transparent" MouseLeftButtonDown="DisplayToolbar_MouseLeftButtonDown">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DashboardModeHint" TextTrimming="CharacterEllipsis" Text="DASHBOARD" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="DashboardSizeButton" Content="Resizable" Click="DashboardSize_Click" Padding="14,8" Margin="0,0,8,0" AutomationProperties.Name="Switch display mode between fill screen and resizable"/>
                                        <Button x:Name="DashboardDisplayButton" Content="Exit display mode" Click="DashboardDisplay_Click" Padding="14,8" AutomationProperties.Name="Exit dashboard display mode" ToolTip="Return to the normal window (Escape)"/>
                                    </WrapPanel>
                                </Grid>
                                <ScrollViewer Grid.Row="1" x:Name="DashboardViewport" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" SizeChanged="DashboardViewport_SizeChanged">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                        <Style.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></Trigger></Style.Triggers>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel x:Name="DashboardContent" VerticalAlignment="Top" Margin="8,4,8,8" SizeChanged="DashboardContent_SizeChanged">
                                    <StackPanel.LayoutTransform><ScaleTransform x:Name="DashboardDisplayScale"/></StackPanel.LayoutTransform>
                                    <local:OrbitSurface x:Name="DashboardUpdateBanner" Margin="0,0,0,12">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplicationUpdateAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="38"
                                                        Height="38"
                                                        CornerRadius="19"
                                                        Background="{DynamicResource RaisedBrush}"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Text="↓" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Wisp update available" FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ApplicationUpdateStatus}"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        Content="{Binding ApplicationUpdateAction}"
                                                        IsEnabled="{Binding CanCheckApplicationUpdate}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Click="CheckApplicationUpdate_Click"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Review available Wisp update" />
                                                </Grid>
                                            </local:OrbitSurface>

                                    <local:OrbitSurface x:Name="OrbitInstrument" Treatment="Instrument" Shape="Swept" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource OrbitBorderBrush}" BorderThickness="{DynamicResource OrbitStrokeThickness}" CornerRadius="{DynamicResource OrbitCornerRadius}" Padding="112,6,62,12" SizeChanged="DashboardContent_SizeChanged">
                                        <StackPanel>
                                            <Grid Height="100">
                                                <local:DashboardTachometer x:Name="DashboardRpmArc" MaxWidth="900" Height="90" HorizontalAlignment="Stretch" VerticalAlignment="Top" Frame="{Binding NativeGaugeFrame}" IsAvailable="{Binding HasLiveTelemetry}" Accent="{DynamicResource AccentBrush}" Track="{DynamicResource StrokeBrush}" Foreground="{DynamicResource MutedBrush}" Redline="#FF5263"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3">
                                                    <TextBlock Text="Engine" Style="{StaticResource DashLabel}" HorizontalAlignment="Center"/>
                                                    <TextBlock FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                        <Run><Run.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}" Mode="OneWay"><Binding Path="EngineRpm" Converter="{StaticResource MetricPartConverter}" ConverterParameter="rpm"/><Binding Path="HasLiveTelemetry"/></MultiBinding></Run.Text></Run>
                                                        <Run Text=" rpm" FontSize="19" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <local:DashboardColumns x:Name="DashboardInstruments" MinimumColumnWidth="175" MaximumColumns="5" Gap="24" Margin="0,0,0,10"><StackPanel x:Name="DashboardSpeedMetrics" VerticalAlignment="Top" SizeChanged="DashboardContent_SizeChanged">
                                                    <TextBlock Text="Speed" Style="{StaticResource DashHeroLabel}"/>
                                                    <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Viewbox Height="118" Stretch="Uniform" HorizontalAlignment="Left"><TextBlock x:Name="DashboardSpeedNumber" Text="{Binding DashboardSpeed}" FontSize="48" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/></Viewbox>
                                                        <TextBlock Grid.Column="1" Text="{Binding DashboardSpeedUnit}" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="5,0,0,19"/>
                                                    </Grid>
                                                    <TextBlock FontSize="16"><Run Text="Top " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding DashboardTopSpeed, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                                </StackPanel>
<Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0"><StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                                                    <TextBlock Text="Gear" Style="{StaticResource DashHeroLabel}" HorizontalAlignment="Center"/>
                                                    <Border Width="92" Height="92" CornerRadius="46" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="5" Margin="0,14,0,12"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding DashboardGear}" FontSize="64" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="8,0"/></Viewbox></Border>
                                                </StackPanel></Border>
<Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0"><StackPanel VerticalAlignment="Top"><TextBlock Text="Power" Style="{StaticResource DashHeroLabel}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="118" Margin="0,2,0,0"><TextBlock FontSize="48" FontWeight="SemiBold"><Run Text="{Binding DashboardPower, Converter={StaticResource MetricPartConverter}, ConverterParameter=number, Mode=OneWay}"/><Run Text="{Binding DashboardPower, Converter={StaticResource MetricPartConverter}, ConverterParameter=unit, Mode=OneWay}" FontSize="22" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock></Viewbox><TextBlock FontSize="16"><Run Text="Peak " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding DashboardPeakPower, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></StackPanel></Border>
<Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0"><StackPanel VerticalAlignment="Top"><TextBlock Text="Torque" Style="{StaticResource DashHeroLabel}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="118" Margin="0,2,0,0"><TextBlock FontSize="48" FontWeight="SemiBold"><Run Text="{Binding DashboardTorque, Converter={StaticResource MetricPartConverter}, ConverterParameter=number, Mode=OneWay}"/><Run Text="{Binding DashboardTorque, Converter={StaticResource MetricPartConverter}, ConverterParameter=unit, Mode=OneWay}" FontSize="22" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock></Viewbox><TextBlock FontSize="16"><Run Text="Peak " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding DashboardPeakTorque, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></StackPanel></Border>
<Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0"><Button x:Name="DashboardConnectionButton" Style="{StaticResource ConnectionStatusButtonStyle}" Click="ConnectionStatus_Click" VerticalAlignment="Center" ToolTip="Connection status" AutomationProperties.Name="Show connection status"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" Style="{StaticResource DashConnectionDot}"/>
    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding StatusText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
</Grid></Button></Border></local:DashboardColumns>
                                            <Button x:Name="ResetPeaksButton" Content="↶   Reset peaks" Click="ResetDashboardPeaks_Click" HorizontalAlignment="Center" Padding="20,8" AutomationProperties.Name="Reset dashboard power, torque, and top speed peaks"/>
                                        </StackPanel>
                                    </local:OrbitSurface>
                                    <local:FeatureTourBanner x:Name="FeatureTourWelcomeBanner" Visibility="Collapsed" Margin="0,14,0,0" />
                                    <local:DashboardColumns x:Name="DashboardDetails" MinimumColumnWidth="480" MaximumColumns="2" Gap="14" Margin="0,14,0,0">
                                        <local:OrbitSurface x:Name="DashboardRoadPanel" Style="{StaticResource CardStyle}" Padding="30,18" CornerRadius="{DynamicResource OrbitCornerRadius}">
                                            <StackPanel>
                                                <StackPanel x:Name="DashboardVehicleSection">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Path Data="M3,12 L6,4 L22,4 L25,12 M2,12 L26,12 L26,22 L2,22 Z M5,22 L5,25 M23,22 L23,25 M6,16 L9,16 M19,16 L22,16" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="Vehicle" FontSize="19" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                    <local:DashboardColumns MinimumColumnWidth="110" MaximumColumns="4" Gap="16">
                                                        <StackPanel><TextBlock Text="Car ID" Style="{StaticResource DashLabel}"/><TextBlock FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="CarOrdinal"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="Powertrain" Style="{StaticResource DashLabel}"/><TextBlock FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="DashboardVehicleType"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="Drivetrain" Style="{StaticResource DashLabel}"/><TextBlock FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="Drivetrain"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="Driven wheels" Style="{StaticResource DashLabel}"/><TextBlock FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="SelectedWheels" Converter="{StaticResource MetricPartConverter}" ConverterParameter="wheels"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                                                    </local:DashboardColumns>
                                                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Path Data="M9,2 L2,26 M19,2 L26,26 M14,3 L14,8 M14,12 L14,17 M14,21 L14,26" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="Road and chassis" FontSize="19" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                <local:DashboardColumns x:Name="DashboardRoadReadings" MinimumColumnWidth="110" MaximumColumns="4" Gap="16">
                                                    <StackPanel><TextBlock Text="Indicated" Style="{StaticResource DashLabel}"/><TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="IndicatedSpeed"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="Ground" Style="{StaticResource DashLabel}"/><TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="GroundSpeed"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="Lateral" Style="{StaticResource DashLabel}"/><TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="LateralGText"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="Longitudinal" Style="{StaticResource DashLabel}"/><TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="LongitudinalGText"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                                                </local:DashboardColumns>
                                                <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16,0,12"/>
                                                <local:DashboardColumns MinimumColumnWidth="120" MaximumColumns="3" Gap="16">
                                                    <StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Text="Throttle" Style="{StaticResource DashLabel}"/><TextBlock FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="ThrottleInputText"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Text="Brake" Style="{StaticResource DashLabel}"/><TextBlock FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="BrakeInputText"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Text="Steering" Style="{StaticResource DashLabel}"/><TextBlock FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource DashboardLiveValueConverter}"><Binding Path="SteeringInputText"/><Binding Path="HasLiveTelemetry"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                                                </local:DashboardColumns>
                                            </StackPanel>
                                        </local:OrbitSurface>
                                        <local:OrbitSurface x:Name="DashboardGaugePanel" Style="{StaticResource CardStyle}" Padding="30,18" CornerRadius="{DynamicResource OrbitCornerRadius}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Path Data="M3,22 A13,13 0 1 1 25,22 M14,16 L21,7 M6,8 L8,10 M14,3 L14,6 M23,9 L21,11" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="Gauge state" FontSize="19" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel>
