<CheckBox x:Name="StartWithForzaToggle" Content="Start with Forza"
                                                          IsChecked="{Binding StartWithForza}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Keeps a small companion in the Windows tray. Opens Wisp when FH6 starts; closing Wisp returns it to waiting. Choose Exit Wisp in the tray to quit."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />

<CheckBox x:Name="StartMinimizedWithForzaToggle" Content="Start minimized with Forza"
                                                          IsChecked="{Binding StartMinimizedWithForza}" IsEnabled="{Binding StartWithForza}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="18,13,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Keeps the dashboard minimized on game-triggered launches. Opening Wisp yourself still shows the dashboard."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="72,5,0,0" />

<CheckBox x:Name="StartWithWindowsToggle" Content="Start Wisp with Windows"
                                                          IsChecked="{Binding StartWithWindows}"
                                                          IsEnabled="{Binding CanSetWindowsStartup}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Starts the full companion minimized when you sign in. Start with Forza takes priority and runs only the quiet watcher until the game opens."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />

<CheckBox Content="Minimize when driving starts"
                                                          IsChecked="{Binding AutoMinimizeOnTelemetry}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Minimizes this window when driving begins. Your overlays stay in place."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />
    </StackPanel>
</local:OrbitSurface>
<local:OrbitSurface Margin="0,14,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplicationUpdateAvailable}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="APPLICATION UPDATE" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Application updates" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ApplicationUpdateStatus}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                                           AutomationProperties.LiveSetting="Polite" />

                                                <CheckBox Content="Automatically check on open and daily"
                                                          IsChecked="{Binding AutomaticApplicationUpdateChecks}"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="Option_Changed" Unchecked="Option_Changed"
                                                          Margin="0,16,0,0"
                                                          AutomationProperties.Name="Automatically check for Wisp updates on open and every 24 hours" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="6" Padding="9,4"
                                                        HorizontalAlignment="Right" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsApplicationUpdateAvailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="UPDATE AVAILABLE" Style="{StaticResource EyebrowTextStyle}" FontSize="9" />
                                                </Border>
                                                <TextBlock Text="{Binding InstalledApplicationVersion, StringFormat={}Version {0}}"
                                                           HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" Margin="0,0,0,9" />
                                                <Button x:Name="ApplicationUpdateButton"
                                                        Content="{Binding ApplicationUpdateAction}"
                                                        IsEnabled="{Binding CanCheckApplicationUpdate}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Click="CheckApplicationUpdate_Click"
                                                        AutomationProperties.Name="Check for Wisp updates" />
                                            </StackPanel>
                                        </Grid>
                                    </local:OrbitSurface>





                                    <local:OrbitSurface Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Like Wisp?" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Leave a star on GitHub to help more FH6 drivers find it."
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,18,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="StarWispOnGitHub_Click"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Open Wisp on GitHub to leave a star">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Padding" Value="18,10" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="GitHubButtonBorder"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="22" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="GitHubButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter TargetName="GitHubButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="GitHubButtonBorder" Property="Opacity" Value="0.78" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="GitHubButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter TargetName="GitHubButtonBorder" Property="BorderThickness" Value="2" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="17" Height="17" Margin="0,0,9,0" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          Data="M12,.7 A11.5,11.5 0 0 0 8.36,23.11 C8.94,23.22 9.15,22.86 9.15,22.55 V20.31 C5.97,21 5.3,18.96 5.3,18.96 C4.78,17.63 4.03,17.28 4.03,17.28 C2.99,16.57 4.11,16.58 4.11,16.58 C5.26,16.66 5.86,17.76 5.86,17.76 C6.88,19.5 8.53,19 9.18,18.71 C9.28,17.97 9.58,17.47 9.91,17.19 C7.37,16.9 4.7,15.92 4.7,11.51 C4.7,10.26 5.15,9.23 5.88,8.42 C5.76,8.13 5.37,6.96 5.99,5.38 C5.99,5.38 6.95,5.07 9.15,6.56 A10.9,10.9 0 0 1 14.9,6.56 C17.1,5.07 18.06,5.38 18.06,5.38 C18.68,6.96 18.29,8.13 18.17,8.42 C18.9,9.23 19.35,10.26 19.35,11.51 C19.35,15.93 16.68,16.89 14.13,17.18 C14.54,17.54 14.91,18.25 14.91,19.34 V22.54 C14.91,22.85 15.12,23.22 15.71,23.1 A11.5,11.5 0 0 0 12,.7 Z" />
                                                    <TextBlock Text="Star Wisp on GitHub" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </local:OrbitSurface>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="ReleaseNotesTab" Header="Release Notes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Decorator>
                                <Viewbox x:Name="ReleaseNotesScaleView" Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Margin="0,0,0,22"
                                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource ResponsivePageWidthConverter}}">
                                    <local:OrbitSurface Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="VERSION HISTORY" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="What changed in Wisp" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                                            <Button x:Name="ReplayFeatureTourButton" Content="Replay the quick tour" HorizontalAlignment="Left" Margin="0,10,0,4" AutomationProperties.Name="Replay the Wisp feature tour" />
                                            <TextBlock Text="{x:Static local:ApplicationVersionInfo.ReleaseHistoryIntroduction}"
                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                                       LineHeight="19" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </local:OrbitSurface>

                                    <ItemsControl ItemsSource="{x:Static local:ReleaseNotesCatalog.Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ReleaseNoteEntry}">
                                                <local:OrbitSurface Margin="0,14,0,0" Padding="22,20">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="160" MaxWidth="240" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,22,0">
                                                            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="6"
                                                                    Padding="8,4" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <TextBlock x:Name="ReleaseVersionText" Text="{Binding Version, StringFormat=Version {0}}"
                                                                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
                                                            <TextBlock Text="{Binding Date}" Foreground="{DynamicResource FaintBrush}"
                                                                       FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" LineHeight="21" />
                                                            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,7,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:ReleaseNoteGroup}">
                                                                        <StackPanel Margin="0,10,0,0">
                                                                            <TextBlock Text="{Binding Heading}" Style="{StaticResource EyebrowTextStyle}" />
                                                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid Margin="0,3,0,0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="15" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <Ellipse Width="4" Height="4" Margin="1,7,0,0"
                                                                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                                     Fill="{DynamicResource AccentBrush}" />
                                                                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                                                       TextWrapping="Wrap" LineHeight="18" FontSize="11" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </local:OrbitSurface>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </Viewbox>
                                </Decorator>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
                <local:OrbitSurface
                    x:Name="SidebarHost"
                    Shape="Capsule"
                    Grid.Row="1"
                    Margin="18,12,18,4"
                    Padding="12,10,64,10"
                    MaxWidth="928"
                    Background="{DynamicResource OrbitCardBrush}"
                    BorderBrush="{DynamicResource OrbitSurfaceBorderBrush}"
                    BorderThickness="{DynamicResource OrbitStrokeThickness}"
                    CornerRadius="50">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SidebarTranslation" />
                    </Border.RenderTransform>
                    <ListBox
                        x:Name="SidebarNavigation"
                        Style="{StaticResource SidebarNavigationStyle}"
                        Margin="0"
                        Padding="0"
                        Focusable="True"
                        IsTabStop="True"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource OrbitDockItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="False"
                        VerticalAlignment="Center"
                        SelectedIndex="{Binding SelectedIndex, ElementName=RootTabs, Mode=TwoWay}"
                        AutomationProperties.Name="Wisp pages"
                        KeyboardNavigation.DirectionalNavigation="Cycle">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem AutomationProperties.Name="Dashboard">
                            <StackPanel Orientation="Vertical">
                                <Path
                                    Style="{StaticResource OrbitDockIconStyle}"
                                    Data="M2,12 L14,2 L26,12 M5,10 L5,26 L11,26 L11,18 L17,18 L17,26 L23,26 L23,10" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" Style="{StaticResource OrbitDockLabelStyle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Runs">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource OrbitDockIconStyle}" Data="M4,26 L4,15 M11,26 L11,7 M18,26 L18,12 M25,26 L25,2" />
                                <TextBlock Text="Runs" VerticalAlignment="Center" Style="{StaticResource OrbitDockLabelStyle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Appearance">
                            <StackPanel Orientation="Vertical">
                                <Path
                                    Style="{StaticResource OrbitDockIconStyle}"
                                    Data="M8,18 L20,3 C23,0 27,3 25,6 L13,21 Z M5,19 C0,21 7,24 2,28 C10,28 14,24 11,20 Z" />
                                <TextBlock Text="Appearance" VerticalAlignment="Center" Style="{StaticResource OrbitDockLabelStyle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Diagnostics">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource OrbitDockIconStyle}" Data="M1,15 L8,15 L12,3 L17,26 L21,10 L24,15 L29,15" />
                                <TextBlock Text="Diagnostics" VerticalAlignment="Center" Style="{StaticResource OrbitDockLabelStyle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Profiles">
                            <StackPanel Orientation="Vertical">
                                <Path
                                    Style="{StaticResource OrbitDockIconStyle}"
                                    Data="M20,8 A6,6 0 1 1 8,8 A6,6 0 1 1 20,8 M3,28 L3,24 C3,15 25,15 25,24 L25,28" />
                                <TextBlock Text="Profiles" VerticalAlignment="Center" Style="{StaticResource OrbitDockLabelStyle}" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem AutomationProperties.Name="Extras">
                            <StackPanel Orientation="Vertical">
                                <Path
                                    Style="{StaticResource OrbitDockIconStyle}"
                                    Data="M3,3 L12,3 L12,12 L3,12 Z M18,3 L27,3 L27,12 L18,12 Z M3,18 L12,18 L12,27 L3,27 Z M18,18 L27,18 L27,27 L18,27 Z" />
                                <TextBlock Text="Extras" VerticalAlignment="Center" Style="{StaticResource OrbitDockLabelStyle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Release Notes">
                            <StackPanel Orientation="Vertical">
                                <Path
                                    Style="{StaticResource OrbitDockIconStyle}"
                                    Data="M4,2 L18,2 L25,9 L25,28 L4,28 Z M18,2 L18,9 L25,9 M8,14 L20,14 M8,19 L20,19 M8,24 L16,24" />
                                <TextBlock Text="Release Notes" VerticalAlignment="Center" Style="{StaticResource OrbitDockLabelStyle}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </local:OrbitSurface>
                <Grid
                    x:Name="DockToggleHost"
                    Grid.RowSpan="2"
                    Width="1016"
                    MaxWidth="{Binding ActualWidth, ElementName=ControlBody}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch">
                    <Button
                        x:Name="SidebarToggleButton"
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,22,33"
                        Padding="10"
                        Click="SidebarToggle_Click"
                        ToolTip="Hide navigation dock"
                        AutomationProperties.Name="Hide navigation dock">
                        <Path
                            Width="14"
                            Height="8"
                            Data="M0,7 L7,0 L14,7"
                            Stroke="{DynamicResource MutedBrush}"
                            StrokeThickness="1.6"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SidebarChevronRotation" CenterX="7" CenterY="4" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="HudProfileDialog" Grid.RowSpan="3" Panel.ZIndex="110"
                  Background="#E6090C11" Visibility="Collapsed" Focusable="True"
                  KeyboardNavigation.TabNavigation="Cycle"
                  KeyDown="HudProfileDialog_KeyDown"
                  AutomationProperties.Name="HUD profile confirmation">
                <local:OrbitSurface Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource CardStyle}" BorderThickness="0" Padding="30">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="12"
                                HorizontalAlignment="Left" Background="{DynamicResource RaisedBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Grid Margin="12">
                                <Rectangle Height="4" VerticalAlignment="Top" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}" />
                                <Rectangle Height="4" VerticalAlignment="Center" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}" />
                                <Rectangle Height="4" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HudProfileDialogTitle" FontSize="24" FontWeight="SemiBold"
                                   Margin="0,20,0,0" />
                        <TextBlock x:Name="HudProfileDialogDescription"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   LineHeight="20" Margin="0,9,0,0" />
                        <StackPanel x:Name="HudProfileNamePanel" Margin="0,20,0,0">
                            <TextBlock Text="PROFILE NAME" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBox x:Name="HudProfileNameInput" MaxLength="40" Margin="0,7,0,0"
                                     Padding="12,9" KeyDown="HudProfileNameInput_KeyDown"
                                     AutomationProperties.Name="HUD profile name" />
                        </StackPanel>
                        <TextBlock x:Name="HudProfileDialogError" Visibility="Collapsed"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="Calibration, positions, telemetry, startup, update, and debug settings are never included."
                                   Foreground="{DynamicResource FaintBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,15,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                            <Button Content="Cancel" MinWidth="104" Margin="0,0,10,0"
                                    Click="CancelHudProfileDialog_Click" />
                            <Button x:Name="ConfirmHudProfileButton" MinWidth="150"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="Confirm profile action"
                                    Click="ConfirmHudProfileDialog_Click" />
                        </StackPanel>
                    </StackPanel>
                </local:OrbitSurface>
            </Grid>

            <Grid x:Name="ApplicationUpdateConfirmation" Grid.RowSpan="3" Panel.ZIndex="100"
                  Background="#E6090C11" Visibility="Collapsed" Focusable="True"
                  KeyboardNavigation.TabNavigation="Cycle"
                  KeyDown="ApplicationUpdateConfirmation_KeyDown"
                  AutomationProperties.Name="Confirm Wisp update">
                <local:OrbitSurface Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource CardStyle}" BorderThickness="0" Padding="30">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="23"
                                HorizontalAlignment="Left" Background="{DynamicResource RaisedBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <TextBlock Text="↓" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Ready to update Wisp?" FontSize="24" FontWeight="SemiBold"
                                   Margin="0,20,0,0" />
                        <TextBlock x:Name="ApplicationUpdateConfirmationVersion" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                        <Border x:Name="ApplicationUpdateConfirmationDetails" Visibility="Collapsed"
                                Background="{DynamicResource RaisedBrush}" CornerRadius="8"
                                Padding="14,11" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="What's new" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <ScrollViewer MaxHeight="76" Margin="0,6,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="ApplicationUpdateConfirmationSummary"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                               LineHeight="19"
                                               AutomationProperties.Name="Release summary" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Wisp will download and verify the installer, then restart to finish the update."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   LineHeight="20" Margin="0,18,0,0" />
                        <TextBlock Text="Nothing downloads until you confirm."
                                   Foreground="{DynamicResource FaintBrush}" FontSize="11"
                                   Margin="0,9,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                            <Button Content="Cancel" MinWidth="104" Margin="0,0,10,0"
                                    Click="CancelApplicationUpdate_Click" />
                            <Button x:Name="ConfirmApplicationUpdateButton" Content="Confirm update"
                                    MinWidth="150" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ConfirmApplicationUpdate_Click" />
                        </StackPanel>
                    </StackPanel>
                </local:OrbitSurface>
            </Grid>

            <Grid x:Name="ShellFooter" Grid.Row="2" Margin="29,0">
                <TextBlock Text="Telemetry stays on this PC" VerticalAlignment="Center"
                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" />
                <TextBlock x:Name="ApplicationVersionFooter" Text="{x:Static local:ApplicationVersionInfo.FooterText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10" Foreground="{DynamicResource FaintBrush}" />
            </Grid>
        </Grid>
    </Border>
</local:ControlPanelWindow>
