                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />

                                                <CheckBox Content="Enable visibility shortcut"
                                                          IsChecked="{Binding OverlayHotkeyEnabled}"
                                                          AutomationProperties.Name="Enable HUD visibility shortcut"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <StackPanel Orientation="Horizontal" Margin="54,7,0,0">
                                                    <Button x:Name="OverlayHotkeyCaptureButton"
                                                            Content="{Binding OverlayHotkeyText, Mode=OneWay}"
                                                            AutomationProperties.Name="Change HUD visibility shortcut"
                                                            Click="OverlayHotkeyCapture_Click"
                                                            PreviewKeyDown="OverlayHotkeyCapture_PreviewKeyDown"
                                                            LostKeyboardFocus="OverlayHotkeyCapture_LostKeyboardFocus"
                                                            MinWidth="150" />
                                                    <TextBlock Text="{Binding OverlayHotkeyStatus, Mode=OneWay}"
                                                               Foreground="{DynamicResource FaintBrush}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" Margin="12,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="Click the shortcut, then press a modifier plus another key. It only hides the HUD for this Wisp session."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />

                                                <CheckBox Content="Minimize when driving starts"
                                                          IsChecked="{Binding AutoMinimizeOnTelemetry}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Minimizes this window when driving begins. Your overlays stay in place."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />

                                                <CheckBox x:Name="StartWithForzaToggle" Content="Start with Forza"
                                                          IsChecked="{Binding StartWithForza}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Keeps a small companion in the Windows tray. Opens Wisp when FH6 starts; closing Wisp returns it to waiting. Choose Exit Wisp in the tray to quit."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />

                                                <CheckBox x:Name="StartMinimizedWithForzaToggle" Content="Start minimized with Forza"
                                                          IsChecked="{Binding StartMinimizedWithForza}" IsEnabled="{Binding StartWithForza}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="18,13,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Keeps the dashboard minimized on game-triggered launches. Opening Wisp yourself still shows the dashboard."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="72,5,0,0" />

                                                <CheckBox x:Name="StartWithWindowsToggle" Content="Start Wisp with Windows"
                                                          IsChecked="{Binding StartWithWindows}"
                                                          IsEnabled="{Binding CanSetWindowsStartup}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Starts the full companion minimized when you sign in. Start with Forza takes priority and runs only the quiet watcher until the game opens."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />

                                                <CheckBox Content="Traction hook cue"
                                                          IsChecked="{Binding TractionCueEnabled}"
                                                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                                                <TextBlock Text="Briefly accents the speed number when driven-wheel slip converges with road speed."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" LineHeight="16" Margin="54,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="DISPLAY" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="HUD controls" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,18" />

                                                <TextBlock Text="Layout" Foreground="{DynamicResource MutedBrush}" />
                                                <Border Margin="0,7,0,17" Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="3">
                                                    <UniformGrid Columns="4">
                                                        <RadioButton x:Name="MinimalLayoutRadio" GroupName="Layout" Content="Minimal"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="Layout_Checked" />
                                                        <RadioButton x:Name="CombinedLayoutRadio" GroupName="Layout" Content="Combined"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="Layout_Checked" />
                                                        <RadioButton x:Name="SeparateBoxesLayoutRadio" GroupName="Layout" Content="Two boxes"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="Layout_Checked" />
                                                        <RadioButton x:Name="NativeLayoutRadio" GroupName="Layout" Content="Native"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="Layout_Checked" />
                                                    </UniformGrid>
                                                </Border>

                                                <StackPanel Margin="0,0,0,17">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LayoutSelectionIndex}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Native speedometer" Foreground="{DynamicResource MutedBrush}" />
                                                    <Border Margin="0,7,0,0" Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="3">
                                                        <UniformGrid Columns="2">
                                                            <RadioButton x:Name="NativeDigitalRadio" GroupName="NativeGauge" Content="Digital"
                                                                         Style="{StaticResource SegmentRadioStyle}" Checked="NativeGauge_Checked" />
                                                            <RadioButton x:Name="NativeAnalogueRadio" GroupName="NativeGauge" Content="Analogue"
                                                                         Style="{StaticResource SegmentRadioStyle}" Checked="NativeGauge_Checked" />
                                                        </UniformGrid>
                                                    </Border>
                                                    <TextBlock Text="Turn off FH6's stock speedometer to use Native in its place. Digital and analogue automatically adapt to electric vehicles."
                                                               TextWrapping="Wrap" FontSize="11" LineHeight="16"
                                                               Foreground="{DynamicResource FaintBrush}" Margin="0,8,0,0" />
                                                    <TextBlock Text="{Binding ExactRedlineStateText, StringFormat=Exact redline: {0}}"
                                                               TextWrapping="Wrap" FontSize="11" LineHeight="16"
                                                               Foreground="{DynamicResource FaintBrush}" Margin="0,5,0,0" />
                                                </StackPanel>

                                                <TextBlock Text="Speed source" Foreground="{DynamicResource MutedBrush}" />
                                                <Border Margin="0,7,0,0" Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="3">
                                                    <UniformGrid Columns="2">
                                                        <RadioButton x:Name="WheelSpeedSourceRadio" GroupName="SpeedSource" Content="Wheel-indicated"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="SpeedSource_Checked" />
                                                        <RadioButton x:Name="Fh6SpeedSourceRadio" GroupName="SpeedSource" Content="FH6 speed"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="SpeedSource_Checked" />
                                                    </UniformGrid>
                                                </Border>
                                                <TextBlock Text="Wheel-indicated follows driven-wheel rotation. FH6 speed mirrors the game's vehicle-speed value directly, with no tire learning or smoothing."
                                                           TextWrapping="Wrap" FontSize="11" LineHeight="16"
                                                           Foreground="{DynamicResource FaintBrush}" Margin="0,8,0,17" />

                                                <TextBlock Text="Gear display" Foreground="{DynamicResource MutedBrush}" />
                                                <Border Margin="0,7,0,0" Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="3">
                                                    <UniformGrid Columns="2">
                                                        <RadioButton x:Name="AutomaticGearDisplayRadio" GroupName="GearDisplay" Content="Automatic (D)"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="GearDisplay_Checked" />
                                                        <RadioButton x:Name="ManualGearDisplayRadio" GroupName="GearDisplay" Content="Manual (1–10)"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="GearDisplay_Checked" />
                                                    </UniformGrid>
                                                </Border>
                                                <TextBlock Text="Automatic shows D on every Native gauge. Wisp retains the physical forward gear for telemetry and shift logic."
                                                           TextWrapping="Wrap" FontSize="11" LineHeight="16"
                                                           Foreground="{DynamicResource FaintBrush}" Margin="0,8,0,17" />

                                                <TextBlock Text="Units" Foreground="{DynamicResource MutedBrush}" />
                                                <Border Margin="0,7,0,0" Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="3">
                                                    <UniformGrid Columns="2">
                                                        <RadioButton x:Name="MphRadio" GroupName="Units" Content="MPH"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="Unit_Checked" />
                                                        <RadioButton x:Name="KphRadio" GroupName="Units" Content="KM/H"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="Unit_Checked" />
                                                    </UniformGrid>
                                                </Border>

                                                <TextBlock Text="Torque units" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" />
                                                <Border Margin="0,7,0,0" Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="3">
                                                    <UniformGrid Columns="2">
                                                        <RadioButton x:Name="NewtonMetersRadio" GroupName="TorqueUnits" Content="Nm"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="TorqueUnit_Checked" />
                                                        <RadioButton x:Name="PoundFeetRadio" GroupName="TorqueUnits" Content="lb-ft"
                                                                     Style="{StaticResource SegmentRadioStyle}" Checked="TorqueUnit_Checked" />
                                                    </UniformGrid>
                                                </Border>

                                                <Grid Margin="0,18,0,5">
                                                    <TextBlock Text="Speed panel size" Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBlock Text="50–200%" HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" FontSize="11" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,3">
                                                            <TextBlock Text="WIDTH" Style="{StaticResource EyebrowTextStyle}" />
                                                            <TextBlock Text="{Binding OverlayWidthScale, StringFormat={}{0:P0}}"
                                                                       HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" />
                                                        </Grid>
                                                        <Slider Minimum="0.5" Maximum="2" Value="{Binding OverlayWidthScale}"
                                                                AutomationProperties.Name="Speed panel width"
                                                                TickFrequency="0.05" ValueChanged="Option_Changed" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Grid Margin="0,0,0,3">
                                                            <TextBlock Text="HEIGHT" Style="{StaticResource EyebrowTextStyle}" />
                                                            <TextBlock Text="{Binding OverlayHeightScale, StringFormat={}{0:P0}}"
                                                                       HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" />
                                                        </Grid>
                                                        <Slider Minimum="0.5" Maximum="2" Value="{Binding OverlayHeightScale}"
                                                                AutomationProperties.Name="Speed panel height"
                                                                TickFrequency="0.05" ValueChanged="Option_Changed" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LayoutSelectionIndex}" Value="1">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding LayoutSelectionIndex}" Value="3" />
                                                                        <Condition Binding="{Binding GForceAttached}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Grid Margin="0,13,0,5">
                                                        <TextBlock Text="Standalone G-meter size" Foreground="{DynamicResource MutedBrush}" />
                                                        <TextBlock Text="50–200%" HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" FontSize="11" />
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,3">
                                                                <TextBlock Text="WIDTH" Style="{StaticResource EyebrowTextStyle}" />
                                                                <TextBlock Text="{Binding GForceWidthScale, StringFormat={}{0:P0}}"
                                                                           HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" />
                                                            </Grid>
                                                            <Slider Minimum="0.5" Maximum="2" Value="{Binding GForceWidthScale}"
                                                                    AutomationProperties.Name="G-meter width"
                                                                    TickFrequency="0.05" ValueChanged="Option_Changed" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,3">
                                                                <TextBlock Text="HEIGHT" Style="{StaticResource EyebrowTextStyle}" />
                                                                <TextBlock Text="{Binding GForceHeightScale, StringFormat={}{0:P0}}"
                                                                           HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" />
                                                            </Grid>
                                                            <Slider Minimum="0.5" Maximum="2" Value="{Binding GForceHeightScale}"
                                                                    AutomationProperties.Name="G-meter height"
                                                                    TickFrequency="0.05" ValueChanged="Option_Changed" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Margin="0,15,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding LayoutSelectionIndex}" Value="3" />
                                                                        <Condition Binding="{Binding TireTemperatureGaugeAttached}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Grid Margin="0,0,0,5">
                                                        <TextBlock Text="Detached tire temperature gauge size" Foreground="{DynamicResource MutedBrush}" />
                                                        <TextBlock Text="50–200%" HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" FontSize="11" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="SIZE" Style="{StaticResource EyebrowTextStyle}" />
                                                        <TextBlock Text="{Binding TireTemperatureGaugeScale, StringFormat={}{0:P0}}"
                                                                   HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" />
                                                    </Grid>
                                                    <Slider Minimum="0.5" Maximum="2" Value="{Binding TireTemperatureGaugeScale}"
                                                            AutomationProperties.Name="Detached tire temperature gauge size"
                                                            TickFrequency="0.05" ValueChanged="Option_Changed" />
                                                </StackPanel>

                                                <StackPanel Margin="0,15,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding LayoutSelectionIndex}" Value="3" />
                                                                        <Condition Binding="{Binding NativeGaugeSelectionIndex}" Value="1" />
                                                                        <Condition Binding="{Binding BoostGaugeAttached}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Grid Margin="0,0,0,5">
                                                        <TextBlock Text="Detached boost gauge size" Foreground="{DynamicResource MutedBrush}" />
                                                        <TextBlock Text="50–200%" HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" FontSize="11" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="SIZE" Style="{StaticResource EyebrowTextStyle}" />
                                                        <TextBlock Text="{Binding BoostGaugeScale, StringFormat={}{0:P0}}"
                                                                   HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" />
                                                    </Grid>
                                                    <Slider Minimum="0.5" Maximum="2" Value="{Binding BoostGaugeScale}"
                                                            AutomationProperties.Name="Detached boost gauge size"
                                                            TickFrequency="0.05" ValueChanged="Option_Changed" />
                                                </StackPanel>

                                                <StackPanel Margin="0,15,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LayoutSelectionIndex}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Native G-force axes" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                                                    <CheckBox Content="Invert lateral axis (X)"
                                                              IsChecked="{Binding InvertLateralG}"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              Checked="Option_Changed" Unchecked="Option_Changed" />
                                                    <TextBlock Text="Default: left turn moves the bubble right."
                                                               TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                               FontSize="11" Margin="54,4,0,0" />
                                                    <CheckBox Content="Invert longitudinal axis (Y)"
                                                              IsChecked="{Binding InvertLongitudinalG}"
                                                              Style="{StaticResource ToggleSwitchStyle}" Margin="0,13,0,0"
                                                              Checked="Option_Changed" Unchecked="Option_Changed" />
                                                    <TextBlock Text="Default: acceleration moves down and braking moves up."
                                                               TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                                                               FontSize="11" Margin="54,4,0,0" />
                                                </StackPanel>

                                                <Grid Margin="0,13,0,5">
                                                    <TextBlock Text="Opacity" Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource FaintBrush}" FontSize="11" />
                                                </Grid>
                                                <Slider Minimum="0.35" Maximum="1" Value="{Binding OverlayOpacity}"
                                                        AutomationProperties.Name="HUD opacity"
                                                        TickFrequency="0.05" ValueChanged="Option_Changed" />

                                                <Grid Margin="0,13,0,5">
                                                    <TextBlock Text="Speed smoothing" Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBlock Text="{Binding Smoothing, StringFormat={}{0:P0}}" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource FaintBrush}" FontSize="11" />
                                                </Grid>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding Smoothing}"
                                                        AutomationProperties.Name="Wheel-speed smoothing"
                                                        TickFrequency="0.05" ValueChanged="Option_Changed" />

                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="POSITION" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Arrange overlays" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,10" />
                                                <TextBlock Text="Edit mode unlocks both windows. Each keeps its own position per monitor and resolution."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="19" />
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="AppearanceLockButton" Content="Edit HUD layout" Click="ToggleLock_Click" />
                                                    <Button Content="Reset HUD positions" Margin="8,0,0,0" Click="ResetPosition_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Save combination to Profiles"
                                                HorizontalAlignment="Right" Margin="0,14,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="SaveHudProfile_Click"
                                                AutomationProperties.Name="Save current HUD combination to Profiles" />
                                    </StackPanel>
                                </Grid>
                                </Viewbox>
                                </Decorator>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Diagnostics">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Decorator>
                                <Viewbox x:Name="DiagnosticsScaleView" Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Margin="0,0,0,22"
                                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource ResponsivePageWidthConverter}}">
                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="CONNECTION" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Telemetry stream" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,16" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Packet rate" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PacketRate}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Text="Packet age" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PacketAge}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="2" Text="Display rate" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RenderRate}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="3" Text="Rejected" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RejectedPackets}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="4" Text="Car ID" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CarOrdinal}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="5" Text="Drivetrain" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Drivetrain}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="VEHICLE MODEL" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Wheel-speed calculation" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,16" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Ground speed" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding GroundSpeed}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Text="Indicated" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IndicatedSpeed}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" TextWrapping="Wrap" TextAlignment="Right" />
                                                    <TextBlock Grid.Row="2" Text="Wheel rad/s" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WheelSpeeds}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,6" TextWrapping="Wrap" TextAlignment="Right" />
                                                    <TextBlock Grid.Row="3" Text="Slip ratios" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SlipRatios}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,6" TextWrapping="Wrap" TextAlignment="Right" />
                                                    <TextBlock Grid.Row="4" Text="Rolling radius" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Radius}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" TextWrapping="Wrap" TextAlignment="Right" />
                                                    <TextBlock Grid.Row="5" Text="Driven wheels" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedWheels}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="6" Text="Engine RPM" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding EngineRpm}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="7" Text="Maximum RPM" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding EngineMaximumRpm}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="8" Text="Native tach scale" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding NativeTachScale}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,6" TextWrapping="Wrap" TextAlignment="Right" />
                                                    <TextBlock Grid.Row="9" Text="Native assists" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding NativeAssistState}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Margin="0,6" TextWrapping="Wrap" TextAlignment="Right" />
                                                    <TextBlock Grid.Row="10" Text="Assist states" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding NativeAssistDetails}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,6" TextWrapping="Wrap" TextAlignment="Right" />
                                                </Grid>
                                                <Button Content="Relearn current tires" HorizontalAlignment="Right" Margin="0,14,0,0"
                                                        IsEnabled="{Binding CanRelearnCurrentTires}"
                                                        Click="RelearnTires_Click"
                                                        ToolTip="Use after changing wheel or tire diameter on this car." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="EXACT NATIVE REDLINE" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Game compatibility" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,16" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="State" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ExactRedlineStateText}" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Text="Source" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExactRedlineSource}" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right" FontSize="11"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="2" Text="Build validation" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NativeCompatibilityValidation}" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right" FontSize="10"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                </Grid>
                                                <TextBlock x:Name="CompatibilityStatusText" Text="{Binding NativeCompatibilityUpdates}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="CompatibilityCheckButton" Content="Check compatibility" IsEnabled="{Binding CanCheckNativeCompatibility}"
                                                            Click="CheckCompatibility_Click" FontSize="11" Margin="0,0,8,0"
                                                            ToolTip="Available when a signed update publisher is configured. Bundled support works offline."
                                                            ToolTipService.ShowOnDisabled="True" />
                                                    <Button x:Name="CompatibilityImportButton" Content="Import signed pack" IsEnabled="{Binding CanImportNativeCompatibility}"
                                                            Click="ImportCompatibility_Click" FontSize="11" Margin="0,0,8,0"
                                                            ToolTip="Available when a trusted publisher key is configured."
                                                            ToolTipService.ShowOnDisabled="True" />
                                                    <CheckBox x:Name="DebugLoggingToggle" Content="Debug logging"
                                                              IsChecked="{Binding DebugLoggingEnabled, Mode=OneWay}"
                                                              Click="DebugLoggingToggle_Click" VerticalAlignment="Center" FontSize="11"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              AutomationProperties.Name="Enable local debug logging"
                                                              AutomationProperties.HelpText="Opt in for up to 24 hours. No files are created while this is off."
                                                              ToolTip="Opt in for up to 24 hours. No files are created while this is off." />
                                                </WrapPanel>
                                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"
                                                        Margin="0,10,0,0" Padding="0,10,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="DebugLoggingStatusText" Text="{Binding DebugLoggingStatus}"
                                                                   Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" FontSize="11"
                                                                   AutomationProperties.LiveSetting="Polite" />
                                                        <TextBlock Text="Records one local health sample per second for up to 24 hours. Local files are kept for no more than 7 days. No raw packets or memory contents, personal data, addresses, system inventory, or game FPS."
                                                                   Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"
                                                                   FontSize="10" LineHeight="15" Margin="0,4,0,0" />
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button x:Name="DebugLogExportButton" Content="Export debug ZIP"
                                                                    Click="ExportDebugLogs_Click" FontSize="11" Margin="0,0,8,0" />
                                                            <Button x:Name="DebugLogDeleteButton" Content="Delete local logs"
                                                                    Click="DeleteDebugLogs_Click" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="CURRENT CAR" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Native HUD capabilities" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,16" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1.45*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Exact redline" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ExactNativeRedline}" HorizontalAlignment="Right"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Text="Rendered scale" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NativeTachScale}" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right" FontSize="11"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="2" Text="Native assists" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NativeAssistState}" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right" FontSize="10"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                    <TextBlock Grid.Row="3" Text="Gameplay HUD visibility" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameplayHudVisibility, Mode=OneWay}" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right" FontSize="10"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6"
                                                               ToolTip="Guarded gameplay HUD state. Stale means the last observation is older than 250 ms." />
                                                    <TextBlock Grid.Row="4" Text="Visibility shortcut" Foreground="{DynamicResource MutedBrush}" Margin="0,6" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OverlayHotkeyStatus, Mode=OneWay}" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right" FontSize="10"
                                                               FontFamily="Cascadia Mono, Consolas" Margin="0,6" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                </Viewbox>
                                </Decorator>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="ProfilesTab" Header="Profiles">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Decorator>
                                <Viewbox x:Name="ProfilesScaleView" Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Margin="0,0,0,22"
                                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource ResponsivePageWidthConverter}}">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                                <TextBlock Text="HUD PROFILES" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Saved combinations" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                                                <TextBlock Text="Switch the HUD layout, gauges, units, sizing, opacity, and complete color palette together. Profiles never change tire calibration, overlay positions, telemetry, startup, updates, or debug settings."
                                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="HudProfileStatusText" Margin="2,13,2,0"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />

                                    <Border x:Name="HudProfileEmptyState" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                        <StackPanel HorizontalAlignment="Center" Margin="20,26" MaxWidth="520">
                                            <TextBlock Text="No profiles saved yet" FontSize="18" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Set up the HUD in Appearance, choose the complete palette in Extras, then save the combination here."
                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                                       TextAlignment="Center" LineHeight="19" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <ListBox x:Name="HudProfileList" Margin="0,14,0,0"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             AutomationProperties.Name="Saved HUD profiles">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,12" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:HudPreset}">
                                                <Border Style="{StaticResource CardStyle}" Padding="20,17">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}"
                                                                    Click="ApplyHudProfile_Click" />
                                                            <Button Content="Update" Margin="8,0,0,0"
                                                                    Click="UpdateHudProfile_Click" />
                                                            <Button Content="Rename" Margin="8,0,0,0"
                                                                    Click="RenameHudProfile_Click" />
                                                            <Button Content="Delete" Margin="8,0,0,0"
                                                                    Click="DeleteHudProfile_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                </Viewbox>
                                </Decorator>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="SetupTab" Header="Setup">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Decorator>
                                <Viewbox x:Name="SetupScaleView" Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Margin="0,0,0,22"
                                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource ResponsivePageWidthConverter}}">
                                    <TextBlock Text="CONNECT THE GAME" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="One-time FH6 setup" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,5" />
                                    <TextBlock Text="Connect once, then choose FH6 speed or wheel-indicated speed in Appearance."
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />

                                    <UniformGrid Columns="3" Margin="0,20,0,0">
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                                            <StackPanel>
                                                <TextBlock Text="01" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Open Data Out" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                                                <TextBlock Text="FH6 → Settings → HUD and Gameplay. Enable Data Out."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="20" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardStyle}" Margin="5,0">
                                            <StackPanel>
                                                <TextBlock Text="02" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Keep it local" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                                                <TextBlock Text="Set the Data Out IP to 127.0.0.1. No telemetry leaves this PC."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="20" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="03" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Match the port" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                                                <DockPanel Margin="0,9,0,0">
                                                    <Button DockPanel.Dock="Right" Content="Apply" Margin="8,0,0,0"
                                                            Style="{StaticResource PrimaryButtonStyle}" Click="ApplyPort_Click" />
                                                    <TextBox Text="{Binding UdpPortText, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="FH6 Data Out UDP port" />
                                                </DockPanel>
                                                <TextBlock Text="Avoid ports 5200–5300." Foreground="{DynamicResource FaintBrush}" FontSize="11" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="Fullscreen compatibility" FontWeight="SemiBold" />
                                                <TextBlock Text="Use borderless fullscreen so Wisp can appear over FH6. If the overlay is hidden, check this display setting first."
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" LineHeight="19" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                                </Viewbox>
                                </Decorator>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="ExtrasTab" Header="Extras">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,0,22">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplicationUpdateAvailable}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="APPLICATION UPDATE" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Application updates" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ApplicationUpdateStatus}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Text="Immutable GitHub release assets are checked for an exact version, size, and SHA-256 match before installation."
                                                           Foreground="{DynamicResource FaintBrush}" FontSize="11" LineHeight="16"
                                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                                                <CheckBox Content="Automatically check once daily"
                                                          IsChecked="{Binding AutomaticApplicationUpdateChecks}"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="Option_Changed" Unchecked="Option_Changed"
                                                          Margin="0,16,0,0"
                                                          AutomationProperties.Name="Automatically check for Wisp updates once daily" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="6" Padding="9,4"
                                                        HorizontalAlignment="Right" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsApplicationUpdateAvailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="UPDATE AVAILABLE" Style="{StaticResource EyebrowTextStyle}" FontSize="9" />
                                                </Border>
                                                <TextBlock Text="{Binding InstalledApplicationVersion, StringFormat={}Version {0}}"
                                                           HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}"
                                                           FontSize="11" Margin="0,0,0,9" />
                                                <Button x:Name="ApplicationUpdateButton"
                                                        Content="{Binding ApplicationUpdateAction}"
                                                        IsEnabled="{Binding CanCheckApplicationUpdate}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Click="CheckApplicationUpdate_Click"
                                                        AutomationProperties.Name="Check for Wisp updates" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Make it yours" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Tune every color with live hue, saturation, brightness, opacity, and precise ARGB input. Layout and telemetry stay unchanged."
                                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="ColorEditorLayout" Margin="0,20,0,0" MinHeight="350"
                                          HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,13">
                                                    <TextBlock Text="COLOR ELEMENTS" Style="{StaticResource EyebrowTextStyle}" />
                                                    <TextBlock Text="Select one element to edit"
                                                               Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <ListBox x:Name="ColorTargetSelector" Background="Transparent"
                                                         BorderThickness="0" Padding="0" SelectionMode="Single"
                                                         SelectionChanged="ColorTargetSelector_SelectionChanged"
                                                         AutomationProperties.Name="Color customization target">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="Padding" Value="12,10" />
                                                            <Setter Property="Margin" Value="0,0,0,5" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="TargetBorder"
                                                                                Background="Transparent"
                                                                                BorderBrush="Transparent"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="TargetBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="TargetBorder" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                                                                <Setter TargetName="TargetBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="TargetBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBoxItem Content="App accent" />
                                                    <ListBoxItem Content="Background and surfaces" />
                                                    <ListBoxItem Content="HUD border" />
                                                    <ListBoxItem Content="Gauge start" />
                                                    <ListBoxItem Content="Gauge middle" />
                                                    <ListBoxItem Content="Gauge end" />
                                                    <ListBoxItem Content="Traction hook cue" />
                                                </ListBox>
                                            </DockPanel>
                                        </Border>

                                        <local:ColorWheelEditor x:Name="ColorEditor" Grid.Column="2"
                                                                HorizontalAlignment="Stretch" MinHeight="350"
                                                                SelectedColorChanged="ColorEditor_SelectedColorChanged" />
                                    </Grid>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Like Wisp?" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Leave a star on GitHub to help more FH6 drivers find it."
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,18,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="StarWispOnGitHub_Click"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Open Wisp on GitHub to leave a star">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Padding" Value="18,10" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="GitHubButtonBorder"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="22" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="GitHubButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter TargetName="GitHubButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="GitHubButtonBorder" Property="Opacity" Value="0.78" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="GitHubButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter TargetName="GitHubButtonBorder" Property="BorderThickness" Value="2" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="17" Height="17" Margin="0,0,9,0" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          Data="M12,.7 A11.5,11.5 0 0 0 8.36,23.11 C8.94,23.22 9.15,22.86 9.15,22.55 V20.31 C5.97,21 5.3,18.96 5.3,18.96 C4.78,17.63 4.03,17.28 4.03,17.28 C2.99,16.57 4.11,16.58 4.11,16.58 C5.26,16.66 5.86,17.76 5.86,17.76 C6.88,19.5 8.53,19 9.18,18.71 C9.28,17.97 9.58,17.47 9.91,17.19 C7.37,16.9 4.7,15.92 4.7,11.51 C4.7,10.26 5.15,9.23 5.88,8.42 C5.76,8.13 5.37,6.96 5.99,5.38 C5.99,5.38 6.95,5.07 9.15,6.56 A10.9,10.9 0 0 1 14.9,6.56 C17.1,5.07 18.06,5.38 18.06,5.38 C18.68,6.96 18.29,8.13 18.17,8.42 C18.9,9.23 19.35,10.26 19.35,11.51 C19.35,15.93 16.68,16.89 14.13,17.18 C14.54,17.54 14.91,18.25 14.91,19.34 V22.54 C14.91,22.85 15.12,23.22 15.71,23.1 A11.5,11.5 0 0 0 12,.7 Z" />
                                                    <TextBlock Text="Star Wisp on GitHub" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="ReleaseNotesTab" Header="Release Notes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Decorator>
                                <Viewbox x:Name="ReleaseNotesScaleView" Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Margin="0,0,0,22"
                                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource ResponsivePageWidthConverter}}">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="VERSION HISTORY" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="What changed in Wisp" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                                            <TextBlock Text="Feature updates, hotfixes, and important refinements from every documented public release. The current 1.0.10 entry summarizes this release."
                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                                       LineHeight="19" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{x:Static local:ReleaseNotesCatalog.Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ReleaseNoteEntry}">
                                                <Border Margin="0,14,0,0" Padding="22,20">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="138" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,22,0">
                                                            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="6"
                                                                    Padding="8,4" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Version, StringFormat=Version {0}}"
                                                                       FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
                                                            <TextBlock Text="{Binding Date}" Foreground="{DynamicResource FaintBrush}"
                                                                       FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" LineHeight="21" />
                                                            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,7,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:ReleaseNoteGroup}">
                                                                        <StackPanel Margin="0,10,0,0">
                                                                            <TextBlock Text="{Binding Heading}" Style="{StaticResource EyebrowTextStyle}" />
                                                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid Margin="0,3,0,0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="15" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <Ellipse Width="4" Height="4" Margin="1,7,0,0"
                                                                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                                     Fill="{DynamicResource AccentBrush}" />
                                                                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                                                       TextWrapping="Wrap" LineHeight="18" FontSize="11" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </Viewbox>
                                </Decorator>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <Grid x:Name="HudProfileDialog" Grid.RowSpan="3" Panel.ZIndex="110"
                  Background="#E6090C11" Visibility="Collapsed" Focusable="True"
                  KeyboardNavigation.TabNavigation="Cycle"
                  KeyDown="HudProfileDialog_KeyDown"
                  AutomationProperties.Name="HUD profile confirmation">
                <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource CardStyle}" BorderThickness="0" Padding="30">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="12"
                                HorizontalAlignment="Left" Background="{DynamicResource RaisedBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Grid Margin="12">
                                <Rectangle Height="4" VerticalAlignment="Top" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}" />
                                <Rectangle Height="4" VerticalAlignment="Center" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}" />
                                <Rectangle Height="4" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HudProfileDialogTitle" FontSize="24" FontWeight="SemiBold"
                                   Margin="0,20,0,0" />
                        <TextBlock x:Name="HudProfileDialogDescription"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   LineHeight="20" Margin="0,9,0,0" />
                        <StackPanel x:Name="HudProfileNamePanel" Margin="0,20,0,0">
                            <TextBlock Text="PROFILE NAME" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBox x:Name="HudProfileNameInput" MaxLength="40" Margin="0,7,0,0"
                                     Padding="12,9" KeyDown="HudProfileNameInput_KeyDown"
                                     AutomationProperties.Name="HUD profile name" />
                        </StackPanel>
                        <TextBlock x:Name="HudProfileDialogError" Visibility="Collapsed"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="Calibration, positions, telemetry, startup, update, and debug settings are never included."
                                   Foreground="{DynamicResource FaintBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,15,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                            <Button Content="Cancel" MinWidth="104" Margin="0,0,10,0"
                                    Click="CancelHudProfileDialog_Click" />
                            <Button x:Name="ConfirmHudProfileButton" MinWidth="150"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="Confirm profile action"
                                    Click="ConfirmHudProfileDialog_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ApplicationUpdateConfirmation" Grid.RowSpan="3" Panel.ZIndex="100"
                  Background="#E6090C11" Visibility="Collapsed" Focusable="True"
                  KeyboardNavigation.TabNavigation="Cycle"
                  KeyDown="ApplicationUpdateConfirmation_KeyDown"
                  AutomationProperties.Name="Confirm Wisp update">
                <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5" Padding="30">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="23"
                                HorizontalAlignment="Left" Background="{DynamicResource RaisedBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <TextBlock Text="↓" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Ready to update Wisp?" FontSize="24" FontWeight="SemiBold"
                                   Margin="0,20,0,0" />
                        <TextBlock x:Name="ApplicationUpdateConfirmationVersion" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                        <Border x:Name="ApplicationUpdateConfirmationDetails" Visibility="Collapsed"
                                Background="{DynamicResource RaisedBrush}" CornerRadius="8"
                                Padding="14,11" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="What's new" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <ScrollViewer MaxHeight="76" Margin="0,6,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="ApplicationUpdateConfirmationSummary"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                               LineHeight="19"
                                               AutomationProperties.Name="Release summary" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Wisp will download the immutable installer, verify its version, size, and SHA-256, then restart to finish installation."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   LineHeight="20" Margin="0,18,0,0" />
                        <TextBlock Text="Nothing downloads until you confirm."
                                   Foreground="{DynamicResource FaintBrush}" FontSize="11"
                                   Margin="0,9,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                            <Button Content="Cancel" MinWidth="104" Margin="0,0,10,0"
                                    Click="CancelApplicationUpdate_Click" />
                            <Button x:Name="ConfirmApplicationUpdateButton" Content="Confirm update"
                                    MinWidth="150" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ConfirmApplicationUpdate_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="29,0">
                <TextBlock Text="LOCAL DATA OUT  ·  READ-ONLY NATIVE HUD  ·  NO INJECTION" VerticalAlignment="Center"
                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" />
                <TextBlock Text="WHEEL-INDICATED SPEED PANEL 1.0.10" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10" Foreground="{DynamicResource FaintBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
