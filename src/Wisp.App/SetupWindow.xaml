<Window x:Class="Wisp.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Wisp.App"
        Title="Wisp Setup" Width="900" Height="780" MinWidth="540" MinHeight="440"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}" Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Cursor="Arrow">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="31" ResizeBorderThickness="6"
                            CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#090D12" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D1218" />
        <SolidColorBrush x:Key="CardBrush" Color="#111822" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#1A2832" />
        <SolidColorBrush x:Key="InputBrush" Color="#0A0F15" />
        <SolidColorBrush x:Key="HoverBrush" Color="#161F29" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#35404F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#63D8D4" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#63D8D4" />
        <Style x:Key="SetupBodyText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="SetupChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadioStyle}">
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="MinHeight" Value="37" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
        </Style>
        <Style x:Key="SetupCaption" TargetType="TextBlock" BasedOn="{StaticResource SetupBodyText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style x:Key="SetupCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SetupSegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style x:Key="SetupStepBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource WindowBrush}" BorderBrush="#24303E" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:AmbientBackdrop x:Name="AmbientScene" Grid.Row="1" Grid.RowSpan="3"
                                   IsAnimationEnabled="{Binding AnimatedBackground}" />
            <Grid Background="{StaticResource PanelBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5,0,12,0" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButtonStyle}" Background="#FF5F57" Click="Close_Click"
                            AutomationProperties.Name="Close setup and exit Wisp" ToolTip="Close setup and exit">
                        <Path Width="6" Height="6" Data="M0,0 L6,6 M6,0 L0,6" Stroke="#C21E0C0D" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" Background="#FEBC2E" Click="Minimize_Click"
                            AutomationProperties.Name="Minimize setup" ToolTip="Minimize">
                        <Path Width="6" Height="6" Data="M0,3 L6,3" Stroke="#C21E0C0D" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" Background="#28C840" Click="Maximize_Click"
                            AutomationProperties.Name="Maximize or restore setup" ToolTip="Maximize or restore">
                        <Rectangle Width="6" Height="6" Stroke="#B80C3419" StrokeThickness="1" RadiusX="1" RadiusY="1" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="HeaderLogo" Width="20" Height="20" Source="pack://application:,,,/Wisp;component/Assets/Wisp-logo.png"
                           AutomationProperties.Name="Wisp logo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Wisp · Setup" FontSize="14" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,24,28,16">
                <TextBlock x:Name="StepLabel" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock x:Name="StepTitle" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                <UniformGrid Columns="4" Margin="0,17,-7,0">
                    <Border x:Name="WelcomeBadge" Style="{StaticResource SetupStepBadge}">
                        <TextBlock x:Name="WelcomeBadgeText" Text="01  Welcome" FontSize="11" />
                    </Border>
                    <Border x:Name="ConnectionBadge" Style="{StaticResource SetupStepBadge}">
                        <TextBlock x:Name="ConnectionBadgeText" Text="02  Connect" FontSize="11" />
                    </Border>
                    <Border x:Name="DisplayBadge" Style="{StaticResource SetupStepBadge}">
                        <TextBlock x:Name="DisplayBadgeText" Text="03  Display" FontSize="11" />
                    </Border>
                    <Border x:Name="AppearanceBadge" Style="{StaticResource SetupStepBadge}">
                        <TextBlock x:Name="AppearanceBadgeText" Text="04  Your HUD" FontSize="11" />
                    </Border>
                </UniformGrid>
            </StackPanel>
            <ScrollViewer x:Name="StepScroll" Grid.Row="2" Margin="28,0,24,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,4,12">
                    <StackPanel x:Name="WelcomeStep">
                        <TextBlock Style="{StaticResource SetupBodyText}" MaxWidth="505" HorizontalAlignment="Left"
                                   Text="Your drive, beautifully in view. Let's connect FH6, check your display, and make Wisp feel like yours." />
                        <Border Style="{StaticResource SetupCard}" Margin="0,20,0,0" MaxWidth="505" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock x:Name="WelcomeChecklistTitle" Text="What we'll check" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource SetupBodyText}" Margin="0,12,0,0"
                                           Text="01  Connect. A quick, local check of FH6's Data Out stream." />
                                <TextBlock Style="{StaticResource SetupBodyText}" Margin="0,8,0,0"
                                           Text="02  Check. Confirm the display and stock speedometer settings." />
                                <TextBlock Style="{StaticResource SetupBodyText}" Margin="0,8,0,0"
                                           Text="03  Personalize. Choose your look, units, and speed display." />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SetupBodyText}" Margin="0,18,0,0" MaxWidth="505" HorizontalAlignment="Left"
                                   Text="Have FH6 ready to drive. Your saved preferences, HUD positions, and compatible tire calibrations stay in place." />
                        <TextBlock Style="{StaticResource SetupCaption}" Margin="0,12,0,0" MaxWidth="505" HorizontalAlignment="Left"
                                   Text="No account needed · Works offline after setup" />
                    </StackPanel>

                    <StackPanel x:Name="ConnectionStep" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SetupBodyText}"
                                   Text="In FH6, open Settings → HUD and Gameplay. Turn Data Out ON, set Data Out IP Address to 127.0.0.1, and set Data Out IP Port to the port below. Apply the game settings." />
                        <Border Style="{StaticResource SetupCard}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Data Out UDP port" FontWeight="SemiBold" />
                                <TextBox x:Name="PortBox" Width="150" HorizontalAlignment="Left" Margin="0,9,0,0"
                                         MaxLength="5" FontSize="18" Padding="10,7"
                                         Background="{StaticResource RaisedBrush}" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource StrokeBrush}" CaretBrush="{StaticResource TextBrush}"
                                         AutomationProperties.Name="FH6 Data Out UDP port" TextChanged="Port_Changed" />
                                <TextBlock Style="{StaticResource SetupBodyText}" FontSize="12" Margin="0,7,0,0"
                                           Text="Use 1024–65535. FH6 reserves 5200–5300. The default is 5500." />
                                <CheckBox x:Name="DataOutConfirmation" Style="{StaticResource ToggleSwitchStyle}"
                                          Margin="0,18,0,0" Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"
                                          AutomationProperties.Name="I configured FH6 Data Out">
                                    <TextBlock Text="I entered these Data Out settings in FH6." TextWrapping="Wrap" MaxWidth="340" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SetupBodyText}" Margin="0,15,0,0"
                                   Text="Start the test, switch to FH6, and drive gently for a few seconds. Come back here to continue. The test stops automatically after 45 seconds." />
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="TestButton" Content="Test Data Out" Click="Test_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,7" />
                            <Button x:Name="CancelTestButton" Content="Cancel test" Click="CancelTest_Click"
                                    IsEnabled="False" Visibility="Collapsed" Margin="0,0,0,7" />
                        </WrapPanel>
                        <ProgressBar x:Name="TestProgress" Height="4" Margin="0,4,0,10" IsIndeterminate="True"
                                     Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                                     AutomationProperties.Name="Data Out connection test running" />
                        <TextBlock x:Name="TestStatus" Style="{StaticResource SetupBodyText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Ready to test. Wisp's HUD stays hidden during setup." />
                        <TextBlock Style="{StaticResource SetupBodyText}" FontSize="11" Margin="0,12,0,0"
                                   Text="Data Out verifies connectivity, not whether FH6's gameplay HUD is visible. The next step uses your confirmations for game display settings." />
                    </StackPanel>

                    <StackPanel x:Name="DisplayStep" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SetupBodyText}"
                                   Text="Wisp does not change these game settings. Check them in FH6, then confirm each one below." />
                        <Border Style="{StaticResource SetupCard}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Display mode" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource SetupBodyText}" Margin="0,9,0,14"
                                           Text="Use borderless fullscreen or windowed mode. True exclusive fullscreen can cover Windows overlays. If Wisp is hidden later, check this first." />
                                <CheckBox x:Name="DisplayConfirmation" Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"
                                          AutomationProperties.Name="I confirmed borderless or windowed display mode">
                                    <TextBlock Text="I confirmed borderless fullscreen or windowed mode." TextWrapping="Wrap" MaxWidth="340" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SetupCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Stock speedometer" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource SetupBodyText}" Margin="0,9,0,14"
                                           Text="For a clean replacement, turn FH6's stock speedometer OFF in HUD and Gameplay. Leave it on while comparing the two. Other game HUD elements can stay enabled." />
                                <CheckBox x:Name="StockHudConfirmation" Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"
                                          AutomationProperties.Name="I reviewed the stock speedometer setting">
                                    <TextBlock Text="I understand when to turn the stock speedometer off." TextWrapping="Wrap" MaxWidth="330" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SetupBodyText}" FontSize="12" Margin="0,15,0,0"
                                   Text="These are your confirmations, not automatic detection. Native HUD compatibility is reported separately in Diagnostics after setup." />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceStep" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SetupBodyText}"
                                   Text="Your saved choices are selected. Everything here can be changed later in Appearance." />
                        <Grid x:Name="AppearanceLayout" Margin="0,17,0,0" SizeChanged="AppearanceLayout_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.08*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="PreviewPane" Style="{StaticResource SetupCard}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="PREVIEW" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock x:Name="PreviewTitle" Text="Your driving view" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                                    <Border Background="{StaticResource InputBrush}" CornerRadius="10" Margin="0,16,0,0" Padding="8">
                                        <Grid x:Name="PreviewStage" Height="282">
                                            <Border x:Name="NumberPreview" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="17,12"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock x:Name="SampleSpeed" Text="67" FontFamily="Bahnschrift SemiCondensed, Bahnschrift, Segoe UI"
                                                               FontSize="90" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="SampleUnit" Text="MPH" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Viewbox x:Name="DigitalPreview" Visibility="Collapsed" Stretch="Uniform"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:NativeDigitalSpeedometer x:Name="DigitalGauge" />
                                            </Viewbox>
                                            <Viewbox x:Name="AnaloguePreview" Visibility="Collapsed" Stretch="Uniform"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:NativeAnalogSpeedometer x:Name="AnalogueGauge" />
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Sample preview · not live FH6 data" Style="{StaticResource SetupCaption}"
                                               TextAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock x:Name="PreviewDescription" Style="{StaticResource SetupCaption}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="PreferencesPane" Grid.Column="2" Style="{StaticResource SetupCard}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="MAKE IT YOURS" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="HUD style" FontWeight="SemiBold" Margin="0,10,0,7" />
                                    <Border Style="{StaticResource SetupSegmentGroup}">
                                        <UniformGrid Columns="4">
                                            <RadioButton x:Name="MinimalChoice" GroupName="SetupLayout" Content="Minimal"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                            <RadioButton x:Name="CombinedChoice" GroupName="SetupLayout" Content="Combined"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                            <RadioButton x:Name="SeparateChoice" GroupName="SetupLayout" Content="Two boxes"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                            <RadioButton x:Name="NativeChoice" GroupName="SetupLayout" Content="Native"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                        </UniformGrid>
                                    </Border>
                                    <Border x:Name="NativeChoices" Style="{StaticResource SetupSegmentGroup}" Margin="0,8,0,0">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="DigitalChoice" GroupName="SetupGauge" Content="Digital"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                            <RadioButton x:Name="AnalogueChoice" GroupName="SetupGauge" Content="Analogue"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="Speed source" FontWeight="SemiBold" Margin="0,13,0,7" />
                                    <Border Style="{StaticResource SetupSegmentGroup}">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="Fh6SpeedChoice" GroupName="SetupSpeed" Content="FH6 speed"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                            <RadioButton x:Name="WheelSpeedChoice" GroupName="SetupSpeed" Content="Wheel-indicated"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock x:Name="SpeedSourceDescription" Style="{StaticResource SetupCaption}" Margin="0,7,0,0" />
                                    <TextBlock Text="Units" FontWeight="SemiBold" Margin="0,12,0,7" />
                                    <Border Style="{StaticResource SetupSegmentGroup}">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="MphChoice" GroupName="SetupUnits" Content="MPH"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                            <RadioButton x:Name="KphChoice" GroupName="SetupUnits" Content="KM/H"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="Gear display" FontWeight="SemiBold" Margin="0,12,0,7" />
                                    <Border Style="{StaticResource SetupSegmentGroup}">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="ManualChoice" GroupName="SetupGear" Content="Manual (1–10)"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                            <RadioButton x:Name="AutomaticChoice" GroupName="SetupGear" Content="Automatic (D)"
                                                         Style="{StaticResource SetupChoice}" Checked="Preference_Changed" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="Changes the display only, not FH6's transmission setting."
                                               Style="{StaticResource SetupCaption}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="28,12,28,20">
                <TextBlock x:Name="WizardError" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,10" Visibility="Collapsed" />
                <DockPanel LastChildFill="False">
                    <Button x:Name="BackButton" Content="Back" Click="Back_Click" DockPanel.Dock="Left" />
                    <Button x:Name="NextButton" Content="Continue" Click="Next_Click" DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" MinWidth="145" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
