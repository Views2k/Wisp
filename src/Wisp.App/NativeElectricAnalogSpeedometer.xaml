<UserControl x:Class="Wisp.App.NativeElectricAnalogSpeedometer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wisp.App"
             Width="345" Height="345"
             IsHitTestVisible="False"
             ClipToBounds="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!-- FH6 Electric Analog native logical coordinate system. -->
    <Grid Width="345" Height="345" Margin="0,0,-20,-56" ClipToBounds="False">
        <Image x:Name="DialImage" Width="345" Height="320"
               Margin="0,-20,0,0" Stretch="Fill" />
        <Image x:Name="GearGaugeImage" Width="345" Height="320"
               Margin="0,-20,0,0" Stretch="Fill" Visibility="Collapsed" />

        <Grid x:Name="DialNumbers">
            <Image x:Name="DialNumber0" Width="20" Height="14" />
            <Image x:Name="DialNumber1" Width="20" Height="14" />
            <Image x:Name="DialNumber2" Width="20" Height="14" />
            <Image x:Name="DialNumber3" Width="20" Height="14" />
            <Image x:Name="DialNumber4" Width="20" Height="14" />
            <Image x:Name="DialNumber5" Width="20" Height="14" />
            <Image x:Name="DialNumber6" Width="20" Height="14" />
            <Image x:Name="DialNumber7" Width="20" Height="14" />
            <Image x:Name="DialNumber8" Width="20" Height="14" />
        </Grid>

        <Grid x:Name="AssistGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Decorator RenderTransformOrigin="0.5,0.5">
                <Decorator.RenderTransform><RotateTransform x:Name="AbsRotation" /></Decorator.RenderTransform>
                <Image x:Name="AbsImage" Width="54" Height="33" Margin="0,0,0,138" Stretch="Fill" />
            </Decorator>
            <Decorator RenderTransformOrigin="0.5,0.5">
                <Decorator.RenderTransform><RotateTransform x:Name="TcrRotation" /></Decorator.RenderTransform>
                <Image x:Name="TcrImage" Width="54" Height="33" Margin="0,0,0,138" Stretch="Fill" />
            </Decorator>
            <Decorator RenderTransformOrigin="0.5,0.5">
                <Decorator.RenderTransform><RotateTransform x:Name="LcRotation" /></Decorator.RenderTransform>
                <Image x:Name="LcImage" Width="54" Height="33" Margin="0,0,0,138" Stretch="Fill" />
            </Decorator>
            <Decorator RenderTransformOrigin="0.5,0.5">
                <Decorator.RenderTransform><RotateTransform x:Name="StmRotation" /></Decorator.RenderTransform>
                <Image x:Name="StmImage" Width="54" Height="33" Margin="0,0,0,138" Stretch="Fill" />
            </Decorator>
        </Grid>

        <Image x:Name="PreviousGearImage" Width="16" Height="24" Opacity="0.40"
               Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><TranslateTransform X="-25" Y="-8" /></Image.RenderTransform>
        </Image>
        <Image x:Name="NextGearImage" Width="16" Height="24" Opacity="0.40"
               Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><TranslateTransform X="25" Y="-8" /></Image.RenderTransform>
        </Image>
        <Image x:Name="GearArcImage" Width="58" Height="22" Margin="0,0,0,71" Stretch="Fill" />
        <Image x:Name="GearImage" Width="25" Height="30" Margin="0,0,0,34" Stretch="Fill" />

        <Canvas x:Name="Needle" Width="345" Height="345" ClipToBounds="False"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform><RotateTransform x:Name="NeedleRotation" /></Canvas.RenderTransform>
            <local:NativeAnalogNeedleVisual x:Name="NeedleMaterial"
                                              IsElectricMaterial="True"
                                            Canvas.Left="223" Canvas.Top="82.5"
                                            Width="94" Height="180" />
        </Canvas>

        <Image x:Name="UnitImage" Width="42" Height="17.25"
               Margin="0,0,56,76.5" VerticalAlignment="Bottom"
               HorizontalAlignment="Right" Stretch="Fill" Opacity="0.50" />

        <StackPanel x:Name="SpeedDigitsPanel" Orientation="Horizontal" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,-12,71.5">
            <Grid Width="60" Height="93" Margin="-9.5,0,0,0">
                <Image x:Name="HundredsImage" Width="60" Height="93" Stretch="Fill" />
            </Grid>
            <Grid Width="60" Height="93" Margin="-9.5,0,0,0">
                <Image x:Name="TensImage" Width="60" Height="93" Stretch="Fill" />
            </Grid>
            <Grid Width="60" Height="93" Margin="-9.5,0,0,0">
                <Image x:Name="OnesImage" Width="60" Height="93" Stretch="Fill" />
            </Grid>
        </StackPanel>

        <StackPanel x:Name="PowerBarPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,46.5">
            <Image x:Name="RegenLabelImage" Width="33.5" Height="21"
                   Margin="0,0,6,-4" VerticalAlignment="Center" Opacity="0.67" />
            <Grid Width="204" Height="16" VerticalAlignment="Center">
                <Grid.RenderTransform><SkewTransform AngleX="-8" /></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RegenColumn" Width="61.2" />
                    <ColumnDefinition x:Name="PowerColumn" Width="142.8" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Background="#4DFFFFFF" ClipToBounds="True">
                    <Rectangle x:Name="RegenIndicator" Fill="White" HorizontalAlignment="Right" Width="0" />
                </Grid>
                <Grid Grid.Column="1" Background="#4DFFFFFF" ClipToBounds="True">
                    <Rectangle x:Name="PowerIndicator" Fill="#FF429BA5" HorizontalAlignment="Left" Width="0" />
                </Grid>
            </Grid>
            <Image x:Name="PowerLabelImage" Width="33.5" Height="21"
                   Margin="6,0,0,-4" VerticalAlignment="Center" Opacity="0.67" />
        </StackPanel>
    </Grid>
</UserControl>
