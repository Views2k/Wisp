<Window x:Class="Wisp.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wisp.App"
        Title="Wisp Speed" Width="160" Height="120"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="False" ShowInTaskbar="False"
        ShowActivated="False">
    <Window.Resources>
        <SolidColorBrush x:Key="HudBorderBrush" Color="#6663D8D4" />
        <SolidColorBrush x:Key="BoostLowBrush" Color="#48D9F1" />
        <SolidColorBrush x:Key="BoostMidBrush" Color="#397FF7" />
        <SolidColorBrush x:Key="BoostHighBrush" Color="#A45CFF" />
        <Style x:Key="SpeedReadoutStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTractionCueActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Viewbox x:Name="RootViewbox" Stretch="Fill" Opacity="0">
        <Grid x:Name="RootPanel" Width="426" Height="310" Background="Transparent">
            <Grid x:Name="MinimalPanel" Width="160" Height="120"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Viewbox Margin="9" Stretch="Uniform">
                    <TextBlock Text="{Binding HudSpeed}" Padding="3,0"
                               FontFamily="Bahnschrift SemiCondensed, Bahnschrift, Segoe UI"
                               FontSize="104" FontWeight="SemiBold"
                               TextAlignment="Center" Style="{StaticResource SpeedReadoutStyle}">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.82" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Viewbox>
            </Grid>

            <Grid x:Name="BoxedSpeedPanel" Width="190" Height="150"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                <Border x:Name="BoxedSpeedBorder" Margin="4" CornerRadius="12" Background="#E10A0E14"
                        BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1">
                    <Viewbox Margin="18,14" Stretch="Uniform">
                        <TextBlock Text="{Binding HudSpeed}" Padding="3,0"
                                   FontFamily="Bahnschrift SemiCondensed, Bahnschrift, Segoe UI"
                                   FontSize="104" FontWeight="SemiBold"
                                   TextAlignment="Center" Style="{StaticResource SpeedReadoutStyle}" />
                    </Viewbox>
                </Border>
            </Grid>

            <Grid x:Name="CombinedPanel" Width="390" Height="166" Visibility="Collapsed">
                <Border x:Name="CombinedBorder" Margin="4" CornerRadius="12" Background="#E10A0E14"
                        BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1">
                    <Grid Margin="14,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="148" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Margin="6,17,10,17" Stretch="Uniform">
                            <TextBlock Text="{Binding HudSpeed}" Padding="3,0"
                                       FontFamily="Bahnschrift SemiCondensed, Bahnschrift, Segoe UI"
                                       FontSize="104" FontWeight="SemiBold"
                                       TextAlignment="Center" Style="{StaticResource SpeedReadoutStyle}" />
                        </Viewbox>

                        <Border Grid.Column="1" Width="1" Background="#33485C" Margin="0,8" />
                        <local:GForceMeterView Grid.Column="2" Margin="13,1,0,1" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="NativeDigitalPanel" Width="320" Height="160" Visibility="Collapsed"
                  HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False">
                <local:NativeDigitalSpeedometer Width="320" Height="160"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>

            <Grid x:Name="NativeAnalogPanel" Width="293" Height="293.5" Visibility="Collapsed"
                  HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False">
                <local:NativeAnalogSpeedometer Width="293" Height="293.5"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>

            <Grid x:Name="NativeElectricDigitalPanel" Width="320" Height="160" Visibility="Collapsed"
                  HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False">
                <local:NativeElectricDigitalSpeedometer Width="320" Height="160"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>

            <Grid x:Name="NativeElectricAnalogPanel" Width="345" Height="345" Visibility="Collapsed"
                  HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False">
                <local:NativeElectricAnalogSpeedometer Width="345" Height="345"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>

            <!-- Attached boost controls are root siblings. Their expanded HUD
                 bounds contain them without stretching or clipping the native
                 speedometer controls. -->
            <local:DigitalBoostRailView x:Name="AttachedDigitalBoost" Width="302" Height="88"
                                        Margin="11,132,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Display="{Binding BoostDisplay}"
                                        PressureUnit="{Binding SelectedBoostPressureUnit}"
                                        ColorNumber="{Binding DigitalBoostGaugeColorNumber}"
                                        UseStockColors="{Binding DigitalBoostGaugeStockColors}"
                                        LowBrush="{DynamicResource BoostLowBrush}"
                                        MidBrush="{DynamicResource BoostMidBrush}"
                                        HighBrush="{DynamicResource BoostHighBrush}" />
            <local:AnalogBoostGaugeView x:Name="AttachedAnalogBoost" Width="136" Height="136"
                                        Margin="276,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Display="{Binding BoostDisplay}"
                                        PressureUnit="{Binding SelectedBoostPressureUnit}"
                                        ColorNumber="{Binding BoostGaugeColorNumber}"
                                        LowBrush="{DynamicResource BoostLowBrush}"
                                        MidBrush="{DynamicResource BoostMidBrush}"
                                        HighBrush="{DynamicResource BoostHighBrush}" />
            <local:DigitalTireTemperatureGaugeView x:Name="AttachedDigitalTireTemperature"
                                                   Width="302" Height="84" Margin="11,210,0,0"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Display="{Binding TireTemperatureDisplay}"
                                                   TemperatureUnit="{Binding SelectedTireTemperatureUnit}"
                                                   ReactiveColors="{Binding TireTemperatureReactiveColors}"
                                                   IsAttached="True"
                                                   LowBrush="{DynamicResource BoostLowBrush}"
                                                   MidBrush="{DynamicResource BoostMidBrush}"
                                                   HighBrush="{DynamicResource BoostHighBrush}" />
            <local:AnalogTireTemperatureGaugeView x:Name="AttachedAnalogTireTemperature"
                                                  Width="116" Height="116" Margin="286,142,0,0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Display="{Binding TireTemperatureDisplay}"
                                                  TemperatureUnit="{Binding SelectedTireTemperatureUnit}"
                                                  ReactiveColors="{Binding TireTemperatureReactiveColors}"
                                                  IsAttached="True"
                                                  IsElectricMaterial="{Binding NativeGaugeFrame.IsElectric}"
                                                  LowBrush="{DynamicResource BoostLowBrush}"
                                                   MidBrush="{DynamicResource BoostMidBrush}"
                                                   HighBrush="{DynamicResource BoostHighBrush}" />
            <local:NativeGForceMeterView x:Name="AttachedNativeGForce" Width="144" Height="100"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Visibility="Collapsed" />
            <Grid x:Name="EditChrome" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="EditBorder" Margin="4" CornerRadius="12" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNativeLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
